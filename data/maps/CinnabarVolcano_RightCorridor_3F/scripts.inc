CinnabarVolcano_RightCorridor_3F_EventScript_DefeatedKoga::
	famechecker FAMECHECKER_KOGA, 1
	clearflag FLAG_HIDE_FAME_CHECKER_KOGA_JOURNAL
	setflag FLAG_DEFEATED_KOGA
	setvar VAR_KOGA_TRIAL_STATE, 4
	msgbox CinnabarVolcano_RightCorridor_3F_Text_KogaAfterBattle
	release
	end

CinnabarVolcano_RightCorridor_3F_Movement_KogaInspectStone::
	walk_in_place_faster_right
	step_end

CinnabarVolcano_RightCorridor_3F_Movement_PlayerJoinPull::
	walk_right
	walk_right
	walk_right
	walk_in_place_faster_up
	step_end

