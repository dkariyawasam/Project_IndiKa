CinnabarVolcano_RightCorridor_3F_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, CinnabarVolcano_RightCorridor_3F_OnTransition
	.byte 0

CinnabarVolcano_RightCorridor_3F_OnTransition::
	goto_if_eq VAR_KOGA_TRIAL_STATE, 3, CinnabarVolcano_RightCorridor_3F_EventScript_CheckKogaScene
	setflag FLAG_HIDE_CINNABAR_VOLCANO_KOGA
	setflag FLAG_HIDE_CINNABAR_VOLCANO_JANINE
	end

CinnabarVolcano_RightCorridor_3F_EventScript_CheckKogaScene::
	clearflag FLAG_HIDE_CINNABAR_VOLCANO_KOGA
	goto_if_set FLAG_KOGA_VOLCANO_JANINE_ARRIVED, CinnabarVolcano_RightCorridor_3F_EventScript_ShowJanine
	setflag FLAG_HIDE_CINNABAR_VOLCANO_JANINE
	end

CinnabarVolcano_RightCorridor_3F_EventScript_ShowJanine::
	clearflag FLAG_HIDE_CINNABAR_VOLCANO_JANINE
	end

CinnabarVolcano_RightCorridor_3F_EventScript_Kira::
	trainerbattle_single TRAINER_VOLCANO_BATTLE_GIRL_KIRA, CinnabarVolcano_RightCorridor_3F_Text_KiraIntro, CinnabarVolcano_RightCorridor_3F_Text_KiraDefeat
	msgbox CinnabarVolcano_RightCorridor_3F_Text_KiraPostBattle, MSGBOX_AUTOCLOSE
	end

CinnabarVolcano_RightCorridor_3F_EventScript_Cole::
	trainerbattle_single TRAINER_VOLCANO_KINDLER_COLE, CinnabarVolcano_RightCorridor_3F_Text_ColeIntro, CinnabarVolcano_RightCorridor_3F_Text_ColeDefeat
	msgbox CinnabarVolcano_RightCorridor_3F_Text_ColePostBattle, MSGBOX_AUTOCLOSE
	end

CinnabarVolcano_RightCorridor_3F_EventScript_Koga::
	lock
	faceplayer
	goto_if_set FLAG_KOGA_VOLCANO_JANINE_ARRIVED, CinnabarVolcano_RightCorridor_3F_EventScript_KogaPostJanine
	msgbox CinnabarVolcano_RightCorridor_3F_Text_KogaFountain
	closemessage
	applymovement LOCALID_KOGA, CinnabarVolcano_RightCorridor_3F_Movement_KogaInspectStone
	waitmovement 0
	msgbox CinnabarVolcano_RightCorridor_3F_Text_KogaLiftStone
	faceplayer
	msgbox CinnabarVolcano_RightCorridor_3F_Text_KogaNeedStrength
	closemessage
	playse SE_M_EXPLOSION
	setfieldeffectargument 0, 13
	setfieldeffectargument 1, 21
	setfieldeffectargument 2, 3
	setfieldeffectargument 3, 2
	dofieldeffect FLDEFF_POP_OUT_OF_ASH
	delay 12
	clearflag FLAG_HIDE_CINNABAR_VOLCANO_JANINE
	addobject LOCALID_JANINE
	waitfieldeffect FLDEFF_POP_OUT_OF_ASH
	msgbox CinnabarVolcano_RightCorridor_3F_Text_JanineArrives
	msgbox CinnabarVolcano_RightCorridor_3F_Text_KogaTryTogether
	closemessage
	applymovement LOCALID_PLAYER, CinnabarVolcano_RightCorridor_3F_Movement_PlayerJoinPull
	waitmovement LOCALID_PLAYER
	applymovement LOCALID_KOGA, CinnabarVolcano_RightCorridor_3F_Movement_KogaInspectStone
	waitmovement LOCALID_KOGA
	delay 16
	msgbox CinnabarVolcano_RightCorridor_3F_Text_PullTogether
	closemessage
	setvar VAR_0x8004, 1
	setvar VAR_0x8005, 1
	setvar VAR_0x8006, 8
	setvar VAR_0x8007, 5
	special ShakeScreen
	waitstate
	msgbox CinnabarVolcano_RightCorridor_3F_Text_StonePulledFree
	closemessage
	applymovement LOCALID_PLAYER, CinnabarVolcano_RightCorridor_3F_Movement_PlayerMakeRoomForKoga
	waitmovement 0
	applymovement LOCALID_KOGA, CinnabarVolcano_RightCorridor_3F_Movement_KogaApproachPlayer
	applymovement LOCALID_JANINE, CinnabarVolcano_RightCorridor_3F_Movement_JanineApproachPlayer
	waitmovement 0
	msgbox CinnabarVolcano_RightCorridor_3F_Text_KogaOfficialChallenge
	setflag FLAG_KOGA_VOLCANO_JANINE_ARRIVED
	setflag FLAG_KOGA_VOLCANO_LAVIC_STONE_PULLED
	goto CinnabarVolcano_RightCorridor_3F_EventScript_KogaAskChallenge
	end

CinnabarVolcano_RightCorridor_3F_EventScript_KogaAskChallenge::
	msgbox CinnabarVolcano_RightCorridor_3F_Text_KogaReadyToBattle, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, CinnabarVolcano_RightCorridor_3F_EventScript_KogaDeclineChallenge
	goto CinnabarVolcano_RightCorridor_3F_EventScript_KogaBattlePicker
	end

CinnabarVolcano_RightCorridor_3F_EventScript_KogaDeclineChallenge::
	release
	end

CinnabarVolcano_RightCorridor_3F_EventScript_KogaPostJanine::
	goto_if_set FLAG_KOGA_VOLCANO_LAVIC_STONE_PULLED, CinnabarVolcano_RightCorridor_3F_EventScript_KogaPostStone
	msgbox CinnabarVolcano_RightCorridor_3F_Text_KogaPostJanine
	release
	end

CinnabarVolcano_RightCorridor_3F_EventScript_KogaPostStone::
	goto_if_set FLAG_DEFEATED_KOGA, CinnabarVolcano_RightCorridor_3F_EventScript_KogaAfterBattle
	msgbox CinnabarVolcano_RightCorridor_3F_Text_KogaPostStone
	goto CinnabarVolcano_RightCorridor_3F_EventScript_KogaAskChallenge

CinnabarVolcano_RightCorridor_3F_EventScript_KogaAfterBattle::
	msgbox CinnabarVolcano_RightCorridor_3F_Text_KogaAfterBattle
	release
	end

CinnabarVolcano_RightCorridor_3F_EventScript_Janine::
	lock
	faceplayer
	goto_if_set FLAG_KOGA_VOLCANO_LAVIC_STONE_PULLED, CinnabarVolcano_RightCorridor_3F_EventScript_JaninePostStone
	msgbox CinnabarVolcano_RightCorridor_3F_Text_JaninePostArrival
	release
	end

CinnabarVolcano_RightCorridor_3F_EventScript_JaninePostStone::
	msgbox CinnabarVolcano_RightCorridor_3F_Text_JaninePostStone
	release
	end

CinnabarVolcano_RightCorridor_3F_EventScript_KogaBattlePicker::
	special GetBadgeCount
	goto_if_eq VAR_RESULT, 0, CinnabarVolcano_RightCorridor_3F_EventScript_KogaChallenge1
	goto_if_eq VAR_RESULT, 1, CinnabarVolcano_RightCorridor_3F_EventScript_KogaChallenge2
	goto_if_eq VAR_RESULT, 2, CinnabarVolcano_RightCorridor_3F_EventScript_KogaChallenge3
	goto_if_eq VAR_RESULT, 3, CinnabarVolcano_RightCorridor_3F_EventScript_KogaChallenge4
	goto_if_eq VAR_RESULT, 4, CinnabarVolcano_RightCorridor_3F_EventScript_KogaChallenge5
	goto_if_eq VAR_RESULT, 5, CinnabarVolcano_RightCorridor_3F_EventScript_KogaChallenge6
	goto CinnabarVolcano_RightCorridor_3F_EventScript_KogaChallenge7

CinnabarVolcano_RightCorridor_3F_EventScript_KogaChallenge1::
	trainerbattle_double TRAINER_LEADER_KOGA_1, CinnabarVolcano_RightCorridor_3F_Text_KogaBattleIntro, CinnabarVolcano_RightCorridor_3F_Text_KogaDefeat, Common_Text_NeedTwoPokemonForDoubleBattle, CinnabarVolcano_RightCorridor_3F_EventScript_DefeatedKoga, NO_MUSIC
	release
