PokemonLeague_BrunosRoom_MapScripts::
	map_script MAP_SCRIPT_ON_LOAD, PokemonLeague_BrunosRoom_OnLoad
	map_script MAP_SCRIPT_ON_TRANSITION, PokemonLeague_BrunosRoom_OnTransition
	map_script MAP_SCRIPT_ON_RESUME, PokemonLeague_BrunosRoom_OnResume
	map_script MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE, PokemonLeague_BrunosRoom_OnWarp
	.byte 0

PokemonLeague_BrunosRoom_OnResume::
	setvar VAR_0x8004, 1
	call PokemonLeague_EventScript_DoLightingEffect
	end

PokemonLeague_BrunosRoom_OnWarp::
	map_script_2 VAR_TEMP_1, 0, PokemonLeague_BrunosRoom_EventScript_TurnPlayerNorth
	.2byte 0

PokemonLeague_BrunosRoom_EventScript_TurnPlayerNorth::
	turnobject LOCALID_PLAYER, DIR_NORTH
	end

PokemonLeague_BrunosRoom_EventScript_ReturnToLobby::
	special ResetLeagueChallenge
	warp MAP_INDIGO_PLATEAU_POKEMON_CENTER_1F, 4, 2
	waitstate
	end

PokemonLeague_BrunosRoom_EventScript_TryEnterChampionRoom::
	lockall
	textcolor NPC_TEXT_COLOR_NEUTRAL
	special IsLeagueChallengeActive
	goto_if_eq VAR_RESULT, 0, PokemonLeague_BrunosRoom_EventScript_ChampionRoomLocked
	special GetLeagueChallengeType
	goto_if_ne VAR_RESULT, 1, PokemonLeague_BrunosRoom_EventScript_ChampionRoomLocked
	special GetLeagueChallengeCurrentTrainer
	goto_if_eq VAR_RESULT, TRAINER_CHAMPION_FIRST_SQUIRTLE, PokemonLeague_BrunosRoom_EventScript_WarpToChampionRoom
	goto_if_eq VAR_RESULT, TRAINER_CHAMPION_FIRST_BULBASAUR, PokemonLeague_BrunosRoom_EventScript_WarpToChampionRoom
	goto_if_eq VAR_RESULT, TRAINER_CHAMPION_FIRST_CHARMANDER, PokemonLeague_BrunosRoom_EventScript_WarpToChampionRoom
	goto_if_eq VAR_RESULT, TRAINER_CHAMPION_REMATCH_SQUIRTLE, PokemonLeague_BrunosRoom_EventScript_WarpToChampionRoom
	goto_if_eq VAR_RESULT, TRAINER_CHAMPION_REMATCH_BULBASAUR, PokemonLeague_BrunosRoom_EventScript_WarpToChampionRoom
	goto_if_eq VAR_RESULT, TRAINER_CHAMPION_REMATCH_CHARMANDER, PokemonLeague_BrunosRoom_EventScript_WarpToChampionRoom
	goto PokemonLeague_BrunosRoom_EventScript_ChampionRoomLocked

PokemonLeague_BrunosRoom_EventScript_WarpToChampionRoom::
	warp MAP_POKEMON_LEAGUE_CHAMPIONS_ROOM, 6, 19
	waitstate
	releaseall
	end

PokemonLeague_BrunosRoom_EventScript_ChampionRoomLocked::
	msgbox PokemonLeague_BrunosRoom_Text_ChampionRoomLocked
	closemessage
	applymovement LOCALID_PLAYER, PokemonLeague_BrunosRoom_Movement_StepBackFromChampionRoom
	waitmovement 0
	releaseall
	end

PokemonLeague_BrunosRoom_EventScript_ReadyPrompt::
	lockall
	textcolor NPC_TEXT_COLOR_NEUTRAL
	msgbox PokemonLeague_BrunosRoom_Text_AreYouReady, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, YES, PokemonLeague_BrunosRoom_EventScript_StartIndigoBattle
	closemessage
	applymovement LOCALID_PLAYER, PokemonLeague_BrunosRoom_Movement_StepBackFromArena
	waitmovement 0
	releaseall
	end

PokemonLeague_BrunosRoom_EventScript_StartIndigoBattle::
	closemessage
	special HasEnoughMonsForDoubleBattle
	goto_if_ne VAR_RESULT, PLAYER_HAS_TWO_USABLE_MONS, PokemonLeague_BrunosRoom_EventScript_NeedTwoPokemon
	special IsLeagueChallengeActive
	call_if_eq VAR_RESULT, 0, PokemonLeague_BrunosRoom_EventScript_StartChallenge
	special GetLeagueChallengeType
	goto_if_ne VAR_RESULT, 1, PokemonLeague_BrunosRoom_EventScript_RestartChallenge
	special GetLeagueChallengeCurrentTrainer
	goto_if_eq VAR_RESULT, TRAINER_ELITE_FOUR_LORELEI, PokemonLeague_BrunosRoom_EventScript_BattleLorelei
	goto_if_eq VAR_RESULT, TRAINER_ELITE_FOUR_BRUNO, PokemonLeague_BrunosRoom_EventScript_BattleBruno
	goto_if_eq VAR_RESULT, TRAINER_ELITE_FOUR_AGATHA, PokemonLeague_BrunosRoom_EventScript_BattleAgatha
	goto_if_eq VAR_RESULT, TRAINER_ELITE_FOUR_LANCE, PokemonLeague_BrunosRoom_EventScript_BattleLance
	goto_if_eq VAR_RESULT, TRAINER_LEADER_BROCK_7, PokemonLeague_BrunosRoom_EventScript_BattleBrock
	goto_if_eq VAR_RESULT, TRAINER_LEADER_MISTY_7, PokemonLeague_BrunosRoom_EventScript_BattleMisty
	goto_if_eq VAR_RESULT, TRAINER_LEADER_LT_SURGE_7, PokemonLeague_BrunosRoom_EventScript_BattleLtSurge
	goto_if_eq VAR_RESULT, TRAINER_LEADER_ERIKA_7, PokemonLeague_BrunosRoom_EventScript_BattleErika
	goto_if_eq VAR_RESULT, TRAINER_LEADER_KOGA_7, PokemonLeague_BrunosRoom_EventScript_BattleKoga
	goto_if_eq VAR_RESULT, TRAINER_LEADER_BLAINE_7, PokemonLeague_BrunosRoom_EventScript_BattleBlaine
	goto_if_eq VAR_RESULT, TRAINER_LEADER_SABRINA_7, PokemonLeague_BrunosRoom_EventScript_BattleSabrina
	goto_if_eq VAR_RESULT, TRAINER_LEADER_GIOVANNI, PokemonLeague_BrunosRoom_EventScript_BattleGiovanni
	goto_if_eq VAR_RESULT, TRAINER_CHAMPION_FIRST_SQUIRTLE, PokemonLeague_BrunosRoom_EventScript_ChampionAwaits
	goto_if_eq VAR_RESULT, TRAINER_CHAMPION_FIRST_BULBASAUR, PokemonLeague_BrunosRoom_EventScript_ChampionAwaits
	goto_if_eq VAR_RESULT, TRAINER_CHAMPION_FIRST_CHARMANDER, PokemonLeague_BrunosRoom_EventScript_ChampionAwaits
	goto_if_eq VAR_RESULT, TRAINER_CHAMPION_REMATCH_SQUIRTLE, PokemonLeague_BrunosRoom_EventScript_ChampionAwaits
	goto_if_eq VAR_RESULT, TRAINER_CHAMPION_REMATCH_BULBASAUR, PokemonLeague_BrunosRoom_EventScript_ChampionAwaits
	goto_if_eq VAR_RESULT, TRAINER_CHAMPION_REMATCH_CHARMANDER, PokemonLeague_BrunosRoom_EventScript_ChampionAwaits
	goto PokemonLeague_BrunosRoom_EventScript_RestartChallenge

PokemonLeague_BrunosRoom_EventScript_RestartChallenge::
	special ResetLeagueChallenge
	call PokemonLeague_BrunosRoom_EventScript_StartChallenge
	goto PokemonLeague_BrunosRoom_EventScript_StartIndigoBattle

PokemonLeague_BrunosRoom_EventScript_StartChallenge::
	special StartIndigoLeagueChallenge
	return

PokemonLeague_BrunosRoom_EventScript_IndigoIntro::
	setobjectxyperm LOCALID_INDIGO_LEAGUE_OPPONENT, 6, 3
	clearflag FLAG_TEMP_1
	addobject LOCALID_INDIGO_LEAGUE_OPPONENT
	setvar VAR_LAST_TALKED, LOCALID_INDIGO_LEAGUE_OPPONENT
	applymovement LOCALID_INDIGO_LEAGUE_OPPONENT, PokemonLeague_BrunosRoom_Movement_OpponentEnter
	waitmovement 0
	msgbox PokemonLeague_BrunosRoom_Text_IndigoIntro
	playbgm MUS_ENCOUNTER_GYM_LEADER, 0
	return

PokemonLeague_BrunosRoom_EventScript_FinishPoolBattle::
	special AdvanceLeagueChallengeRound
	applymovement LOCALID_INDIGO_LEAGUE_OPPONENT, PokemonLeague_BrunosRoom_Movement_OpponentExit
	waitmovement 0
	setflag FLAG_TEMP_1
	removeobject LOCALID_INDIGO_LEAGUE_OPPONENT
	special GetLeagueChallengeRound
	goto_if_eq VAR_RESULT, 4, PokemonLeague_BrunosRoom_EventScript_OpenChampionDoor
	buffernumberstring STR_VAR_1, VAR_RESULT
	msgbox PokemonLeague_BrunosRoom_Text_PostBattle
	goto PokemonLeague_BrunosRoom_EventScript_StepBack

PokemonLeague_BrunosRoom_EventScript_OpenChampionDoor::
	call PokemonLeague_EventScript_OpenDoor
	msgbox PokemonLeague_BrunosRoom_Text_ChampionAwaits
PokemonLeague_BrunosRoom_EventScript_StepBack::
	closemessage
	applymovement LOCALID_PLAYER, PokemonLeague_BrunosRoom_Movement_StepBackFromArena
	waitmovement 0
	releaseall
	end

PokemonLeague_BrunosRoom_EventScript_BattleLorelei::
	setvar VAR_OBJ_GFX_ID_0, OBJ_EVENT_GFX_LORELEI
	call PokemonLeague_BrunosRoom_EventScript_IndigoIntro
	cleartrainerflag TRAINER_ELITE_FOUR_LORELEI
	trainerbattle_no_intro_double TRAINER_ELITE_FOUR_LORELEI, PokemonLeague_BrunosRoom_Text_Defeat, Common_Text_NeedTwoPokemonForDoubleBattle
	goto PokemonLeague_BrunosRoom_EventScript_FinishPoolBattle

