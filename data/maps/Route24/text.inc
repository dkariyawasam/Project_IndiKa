Route24_Text_JustEarnedFabulousPrize::
    .string "Congratulations! You beat our\n"
    .string "five contest TRAINERS!\p"
    .string "You just earned a fabulous prize!$"

Route24_Text_ReceivedNuggetFromRewardGiver::
    .string "{PLAYER} received a NUGGET\n"
    .string "from the challenge host!$"

Route24_Text_YouDontHaveAnyRoom::
    .string "You don't have any room!$"

Route24_Text_KeepTraining::
    .string "That was a fine run across\n"
    .string "NUGGET BRIDGE.\p"
    .string "Keep training, and keep that\n"
    .string "momentum going!$"

Route24_Text_YouAlreadyClaimedPrize::
    .string "You've already claimed your\n"
    .string "NUGGET BRIDGE prize.\p"
    .string "Keep up the good work!$"

Route24_Text_ShaneIntro::
    .string "I saw your feat from the grass!$"

Route24_Text_ShaneDefeat::
    .string "I thought not!$"

Route24_Text_ShanePostBattle::
    .string "I hid because the people on the\n"
    .string "bridge frightened me.$"

Route24_Text_EthanIntro::
    .string "Okay! I'm No. 5!\n"
    .string "I'll stomp you!$"

Route24_Text_EthanDefeat::
    .string "Whoa!\n"
    .string "Too much!$"

Route24_Text_EthanPostBattle::
    .string "I did my best. I have no regrets!$"

Route24_Text_ReliIntro::
    .string "I'm No. 4!\n"
    .string "Getting tired?$"

Route24_Text_ReliDefeat::
    .string "I lost, too!$"

Route24_Text_ReliPostBattle::
    .string "I did my best, so I've no regrets!$"

Route24_Text_TimmyIntro::
    .string "Here's No. 3!\n"
    .string "I won't be easy!$"

Route24_Text_TimmyDefeat::
    .string "Ow!\n"
    .string "Stomped flat!$"

Route24_Text_TimmyPostBattle::
    .string "I did my best. I have no regrets!$"

Route24_Text_AliIntro::
    .string "I'm second!\n"
    .string "Now it's serious!$"

Route24_Text_AliDefeat::
    .string "How could I lose?$"

Route24_Text_AliPostBattle::
    .string "I did my best. I have no regrets!$"

Route24_Text_CaleIntro::
    .string "Welcome to NUGGET BRIDGE!\p"
    .string "Five TRAINERS stand between you\n"
    .string "and the prize at the end.\p"
    .string "I'll cast the first line.\n"
    .string "Ready?$"

Route24_Text_CaleBridgeRematchIntro::
    .string "Back for another run across\n"
    .string "NUGGET BRIDGE?\p"
    .string "Good. I'll test your rhythm\n"
    .string "again.$"

Route24_Text_CaleDefeat::
    .string "Clean catch!$"

Route24_Text_CalePostBattle::
    .string "The bridge challenge starts calm,\n"
    .string "but each step north adds pressure.\p"
    .string "Keep moving and don't let the\n"
    .string "water distract you.$"

Route24_Text_NadiaIntro::
    .string "The bridge looks huge when you're\n"
    .string "small.\p"
    .string "That's why I battle here. It makes\n"
    .string "me feel brave!$"

Route24_Text_NadiaRematchIntro::
    .string "I crossed the bridge once already!\p"
    .string "Now I can battle you without\n"
    .string "getting nervous.$"

Route24_Text_NadiaDefeat::
    .string "Still nervous!$"

Route24_Text_NadiaPostBattle::
    .string "CERULEAN is right there, but this\n"
    .string "bridge feels like its own place.\p"
    .string "Everybody gets a little tougher\n"
    .string "by the far side.$"

Route24_Text_KindraIntro::
    .string "A good SCOUT checks every plank\n"
    .string "before crossing.\p"
    .string "A great SCOUT checks every\n"
    .string "TRAINER too!$"

Route24_Text_KindraRematchIntro::
    .string "I've checked the whole bridge\n"
    .string "again.\p"
    .string "You're still the most interesting\n"
    .string "part of it!$"

Route24_Text_KindraDefeat::
    .string "Bridge checked!$"

Route24_Text_KindraPostBattle::
    .string "ROUTE 24 links CERULEAN to the\n"
    .string "paths beyond the cape.\p"
    .string "It is short, but everyone remembers\n"
    .string "crossing it.$"

Route24_Text_BeckyIntro::
    .string "I run bridge laps when the water\n"
    .string "is bright.\p"
    .string "A quick battle keeps my pace sharp!$"

Route24_Text_BeckyRematchIntro::
    .string "Another lap, another battle.\p"
    .string "Let's see whose pace holds longer!$"

Route24_Text_BeckyDefeat::
    .string "You kept pace!$"

Route24_Text_BeckyPostBattle::
    .string "The bridge is perfect training.\p"
    .string "Flat planks, sea air, and just\n"
    .string "enough room to sprint.$"

Route24_Text_NellIntro::
    .string "I swim beneath the bridge and hear\n"
    .string "every battle overhead.\p"
    .string "Let's see if yours sounds strong\n"
    .string "up close!$"

Route24_Text_NellRematchIntro::
    .string "The water carried your footsteps\n"
    .string "back to me.\p"
    .string "That means rematch time!$"

Route24_Text_NellDefeat::
    .string "That made a splash!$"

Route24_Text_NellPostBattle::
    .string "NUGGET BRIDGE belongs to the\n"
    .string "TRAINERS above and the water below.\p"
    .string "You handled both sides well.$"
