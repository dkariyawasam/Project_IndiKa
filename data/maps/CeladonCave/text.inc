CeladonCave_Text_LanceAftermath::
	.string "LANCE: This is where\n"
	.string "I lost sight of them.\p"
	.string "GIOVANNI's signal was\n"
	.string "breaking.\p"
	.string "MEWTWO was beginning to\n"
	.string "choose for itself.$"

CeladonCave_Text_LanceFlashbackControl::
	.string "GIOVANNI: The signal\n"
	.string "still holds.\p"
	.string "MEWTWO, return to me.$"

CeladonCave_Text_LanceFlashbackBreaksFree::
	.string "MEWTWO: GYAAOOO!\p"
	.string "LANCE: It's rejecting\n"
	.string "his control!$"

CeladonCave_Text_LanceFlashbackGiovanniChase::
	.string "GIOVANNI: MEWTWO!\p"
	.string "You will not escape me.\n"
	.string "Not again!$"

CeladonCave_Text_LanceRepeat::
	.string "LANCE: It fled north.\p"
	.string "GIOVANNI followed it toward\n"
	.string "CERULEAN CAVE.$"
