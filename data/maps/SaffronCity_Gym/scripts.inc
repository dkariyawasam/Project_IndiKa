SaffronCity_Gym_MapScripts::
	map_script MAP_SCRIPT_ON_FRAME_TABLE, SaffronCity_Gym_OnFrame
	map_script MAP_SCRIPT_ON_TRANSITION, SaffronCity_Gym_OnTransition
	.byte 0

SaffronCity_Gym_OnFrame::
	map_script_2 VAR_SABRINA_TRIAL_STATE, 0, SaffronCity_Gym_EventScript_GymGuideInterceptSabrinaAway
	.2byte 0

SaffronCity_Gym_OnTransition::
	call_if_set FLAG_BADGE06_GET, SaffronCity_Gym_EventScript_CompleteSabrinaTrial
	goto_if_eq VAR_SABRINA_TRIAL_STATE, 0, SaffronCity_Gym_EventScript_SetInitialGuideState
	setflag FLAG_HIDE_SAFFRON_CITY_GYM_GUIDE
	goto_if_lt VAR_SABRINA_TRIAL_STATE, 4, SaffronCity_Gym_EventScript_HideSabrina
	clearflag FLAG_HIDE_SAFFRON_CITY_GYM_SABRINA
	clearflag FLAG_HIDE_SAFFRON_CITY_GYM_GUIDE
	end

SaffronCity_Gym_EventScript_SetInitialGuideState::
	clearflag FLAG_HIDE_SAFFRON_CITY_GYM_GUIDE
	goto SaffronCity_Gym_EventScript_HideSabrina

SaffronCity_Gym_EventScript_HideSabrina::
	setflag FLAG_HIDE_SAFFRON_CITY_GYM_SABRINA
	end

SaffronCity_Gym_EventScript_GymGuideInterceptSabrinaAway::
	lockall
	textcolor NPC_TEXT_COLOR_NEUTRAL
	playse SE_PIN
	applymovement LOCALID_SAFFRON_GYM_GUY, Common_Movement_ExclamationMark
	waitmovement 0
	applymovement LOCALID_SAFFRON_GYM_GUY, Common_Movement_Delay48
	waitmovement 0
	applymovement LOCALID_SAFFRON_GYM_GUY, SaffronCity_Gym_Movement_GymGuyApproachEntrance
	waitmovement 0
	applymovement LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterUp
	waitmovement 0
	msgbox SaffronCity_Gym_Text_GymGuideSabrinaAway
	logbookmenu LOGBOOK_MENU_UNLOCK_QUEST, QUEST_GYM_LEADER_TRIALS
	logbookmenu LOGBOOK_MENU_SET_ACTIVE, QUEST_GYM_LEADER_TRIALS
	sublogbookmenu LOGBOOK_MENU_UNLOCK_QUEST, QUEST_GYM_LEADER_TRIALS, SUB_QUEST_SABRINA
	setvar VAR_SABRINA_TRIAL_STATE, 1
	closemessage
	applymovement LOCALID_PLAYER, SaffronCity_Gym_Movement_PlayerStepAsideForGuide
	waitmovement 0
	applymovement LOCALID_SAFFRON_GYM_GUY, SaffronCity_Gym_Movement_GymGuyLeave
	waitmovement 0
	setflag FLAG_HIDE_SAFFRON_CITY_GYM_GUIDE
	removeobject LOCALID_SAFFRON_GYM_GUY
	releaseall
	end

SaffronCity_Gym_EventScript_Sabrina::
	apexlog APEX_LOG_PERSON_SABRINA, APEX_LOG_PICK_STATE_COLORED, UpdatePickStateFromSpecialVar8005
	goto_if_set FLAG_DEFEATED_SABRINA, SaffronCity_Gym_EventScript_SabrinaPostFieldVictory
	special GetBadgeCount
	goto_if_eq VAR_RESULT, 0, SaffronCity_Gym_EventScript_SabrinaChallenge1
	goto_if_eq VAR_RESULT, 1, SaffronCity_Gym_EventScript_SabrinaChallenge2
	goto_if_eq VAR_RESULT, 2, SaffronCity_Gym_EventScript_SabrinaChallenge3
	goto_if_eq VAR_RESULT, 3, SaffronCity_Gym_EventScript_SabrinaChallenge4
	goto_if_eq VAR_RESULT, 4, SaffronCity_Gym_EventScript_SabrinaChallenge5
	goto_if_eq VAR_RESULT, 5, SaffronCity_Gym_EventScript_SabrinaChallenge6
	goto SaffronCity_Gym_EventScript_SabrinaChallenge7

SaffronCity_Gym_EventScript_SabrinaChallenge1::
	trainerbattle_double TRAINER_LEADER_SABRINA_1, SaffronCity_Gym_Text_SabrinaIntro, SaffronCity_Gym_Text_SabrinaDefeat, Common_Text_NeedTwoPokemonForDoubleBattle, SaffronCity_Gym_EventScript_DefeatedSabrina, NO_MUSIC
	msgbox SaffronCity_Gym_Text_SabrinaPostBattle
	release
	end

