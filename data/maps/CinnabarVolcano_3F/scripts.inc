CinnabarVolcano_3F_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, CinnabarVolcano_3F_OnTransition
	map_script MAP_SCRIPT_ON_RESUME, CinnabarVolcano_3F_OnResume
	.byte 0

CinnabarVolcano_3F_OnTransition::
	call CinnabarVolcano_3F_EventScript_HideMoltres
	goto_if_set FLAG_FOUGHT_VOLCANO_MOLTRES, CinnabarVolcano_3F_EventScript_MoltresHidden
	setvar VAR_0x8004, SUB_QUEST_APEX_MOLTRES
	specialvar VAR_RESULT, IsApexRevealed
	call_if_eq VAR_RESULT, TRUE, CinnabarVolcano_3F_EventScript_ShowMoltres
CinnabarVolcano_3F_EventScript_MoltresHidden::
	end

CinnabarVolcano_3F_OnResume::
	call_if_set FLAG_SYS_SPECIAL_WILD_BATTLE, CinnabarVolcano_3F_EventScript_TryRemoveMoltres
	end

CinnabarVolcano_3F_EventScript_TryRemoveMoltres::
	specialvar VAR_RESULT, GetBattleOutcome
	goto_if_ne VAR_RESULT, B_OUTCOME_CAUGHT, EventScript_Return
	removeobject VAR_LAST_TALKED
	return

CinnabarVolcano_3F_EventScript_ShowMoltres::
	clearflag FLAG_HIDE_CINNABAR_VOLCANO_MOLTRES
	return

CinnabarVolcano_3F_EventScript_HideMoltres::
	setflag FLAG_HIDE_CINNABAR_VOLCANO_MOLTRES
	return

CinnabarVolcano_3F_EventScript_Blair::
	trainerbattle_single TRAINER_VOLCANO_KINDLER_BLAIR, CinnabarVolcano_3F_Text_BlairIntro, CinnabarVolcano_3F_Text_BlairDefeat
	specialvar VAR_RESULT, ShouldTryRematchBattle
	goto_if_eq VAR_RESULT, TRUE, CinnabarVolcano_3F_EventScript_BlairRematch
	msgbox CinnabarVolcano_3F_Text_BlairPostBattle, MSGBOX_AUTOCLOSE
	setvar VAR_0x8004, SUB_QUEST_APEX_MOLTRES
	setvar VAR_0x8005, 2
	call EventScript_RecordApexRumorWithFeedback
	end

CinnabarVolcano_3F_EventScript_BlairRematch::
	trainerbattle_rematch TRAINER_VOLCANO_KINDLER_BLAIR, CinnabarVolcano_3F_Text_BlairIntro, CinnabarVolcano_3F_Text_BlairDefeat
	msgbox CinnabarVolcano_3F_Text_BlairPostBattle, MSGBOX_AUTOCLOSE
	setvar VAR_0x8004, SUB_QUEST_APEX_MOLTRES
	setvar VAR_0x8005, 2
	call EventScript_RecordApexRumorWithFeedback
	end

