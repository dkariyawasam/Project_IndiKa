Route18_Text_WiltonIntro::
    .string "This road runs fast from the\n"
    .string "city to the coast!$"

Route18_Text_WiltonDefeat::
    .string "You passed me!$"

Route18_Text_WiltonPostBattle::
    .string "FUCHSIA gets quiet fast, but this\n"
    .string "road still has a city pulse.$"

Route18_Text_RamiroIntro::
    .string "Cyclists barrel down from the\n"
    .string "north, so keep your eyes open.$"

Route18_Text_RamiroDefeat::
    .string "I blinked first!$"

Route18_Text_RamiroPostBattle::
    .string "ROUTE 18 feels like the city is\n"
    .string "still deciding where to end.$"

Route18_Text_JacobIntro::
    .string "You want through?\n"
    .string "Show me you can handle the road.$"

Route18_Text_JacobDefeat::
    .string "Road's yours!$"

Route18_Text_JacobPostBattle::
    .string "The downhill rush from CELADON\n"
    .string "ends here by FUCHSIA.$"

Route18_Text_LenaIntro::
    .string "I came out from FUCHSIA to watch\n"
    .string "the cyclists race by.$"

Route18_Text_LenaDefeat::
    .string "You were quick too!$"

Route18_Text_LenaPostBattle::
    .string "The city feels close here, even\n"
    .string "with the trees around us.$"

Route18_Text_PaxtonIntro::
    .string "A short road still teaches you\n"
    .string "plenty if you pay attention.$"

Route18_Text_PaxtonDefeat::
    .string "Lesson learned!$"

Route18_Text_PaxtonPostBattle::
    .string "I like training where town paths\n"
    .string "and open road meet.$"

Route18_Text_RinaIntro::
    .string "I packed light.\n"
    .string "ROUTE 18 is all momentum!$"

Route18_Text_RinaDefeat::
    .string "Momentum gone!$"

Route18_Text_RinaPostBattle::
    .string "You can feel the whole road\n"
    .string "pointing toward FUCHSIA.$"

Route18_Text_RouteSign::
    .string "ROUTE 18\n"
    .string "CELADON CITY - FUCHSIA CITY$"

Route18_Text_CyclingRoadSign::
    .string "CYCLING ROAD\n"
    .string "No pedestrians permitted!$"
