	trainerbattle_double TRAINER_LEADER_MISTY_5, CeruleanCity_Gym_Text_MistyIntro, CeruleanCity_Gym_Text_MistyDefeat, Common_Text_NeedTwoPokemonForDoubleBattle, CeruleanCity_Gym_EventScript_MistyDefeated, NO_MUSIC
	end

