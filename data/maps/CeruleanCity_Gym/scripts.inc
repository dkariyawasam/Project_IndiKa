CeruleanCity_Gym_MapScripts::
	map_script MAP_SCRIPT_ON_FRAME_TABLE, CeruleanCity_Gym_OnFrame
	map_script MAP_SCRIPT_ON_TRANSITION, CeruleanCity_Gym_OnTransition
	.byte 0

CeruleanCity_Gym_OnFrame::
	map_script_2 VAR_MISTY_TRIAL_STATE, 0, CeruleanCity_Gym_EventScript_GymGuideInterceptMistyAway
	.2byte 0

CeruleanCity_Gym_OnTransition::
	goto_if_lt VAR_MISTY_TRIAL_STATE, 9, CeruleanCity_Gym_EventScript_HideMisty
	clearflag FLAG_HIDE_CERULEAN_CITY_GYM_MISTY
	end

CeruleanCity_Gym_EventScript_HideMisty::
	setflag FLAG_HIDE_CERULEAN_CITY_GYM_MISTY
	end

CeruleanCity_Gym_EventScript_GymGuideInterceptMistyAway::
	lockall
	textcolor NPC_TEXT_COLOR_NEUTRAL
	playse SE_PIN
	applymovement LOCALID_CERULEAN_GYM_GUIDE, Common_Movement_ExclamationMark
	waitmovement 0
	applymovement LOCALID_CERULEAN_GYM_GUIDE, Common_Movement_Delay48
	waitmovement 0
	applymovement LOCALID_CERULEAN_GYM_GUIDE, CeruleanCity_Gym_Movement_GymGuideApproachEntrance
	waitmovement 0
	applymovement LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterUp
	waitmovement 0
	msgbox CeruleanCity_Gym_Text_GymGuideMistyAway
	questmenu QUEST_MENU_UNLOCK_QUEST, QUEST_GYM_LEADER_TRIALS
	questmenu QUEST_MENU_SET_ACTIVE, QUEST_GYM_LEADER_TRIALS
	subquestmenu QUEST_MENU_UNLOCK_QUEST, QUEST_GYM_LEADER_TRIALS, SUB_QUEST_MISTY
	setvar VAR_MISTY_TRIAL_STATE, 1
	closemessage
	applymovement LOCALID_CERULEAN_GYM_GUIDE, CeruleanCity_Gym_Movement_GymGuideReturnToSpot
	waitmovement 0
	releaseall
	end

CeruleanCity_Gym_EventScript_Misty::
	famechecker FAMECHECKER_MISTY, FCPICKSTATE_COLORED, UpdatePickStateFromSpecialVar8005
	goto_if_eq VAR_MISTY_TRIAL_STATE, 10, CeruleanCity_Gym_EventScript_MistyGyaradosCheck
	goto_if_eq VAR_MISTY_TRIAL_STATE, 11, CeruleanCity_Gym_EventScript_MistyTradeDone
	goto_if_set FLAG_DEFEATED_MISTY, CeruleanCity_Gym_EventScript_MistyPostBattle
	special GetBadgeCount
	goto_if_eq VAR_RESULT, 0, CeruleanCity_Gym_EventScript_MistyChallenge1
	goto_if_eq VAR_RESULT, 1, CeruleanCity_Gym_EventScript_MistyChallenge2
	goto_if_eq VAR_RESULT, 2, CeruleanCity_Gym_EventScript_MistyChallenge3
	goto_if_eq VAR_RESULT, 3, CeruleanCity_Gym_EventScript_MistyChallenge4
	goto_if_eq VAR_RESULT, 4, CeruleanCity_Gym_EventScript_MistyChallenge5
	goto_if_eq VAR_RESULT, 5, CeruleanCity_Gym_EventScript_MistyChallenge6
	goto CeruleanCity_Gym_EventScript_MistyChallenge7

CeruleanCity_Gym_EventScript_MistyChallenge1::
	trainerbattle_double TRAINER_LEADER_MISTY_1, CeruleanCity_Gym_Text_MistyIntro, CeruleanCity_Gym_Text_MistyDefeat, Common_Text_NeedTwoPokemonForDoubleBattle, CeruleanCity_Gym_EventScript_MistyDefeated, NO_MUSIC
	end

CeruleanCity_Gym_EventScript_MistyChallenge2::
	trainerbattle_double TRAINER_LEADER_MISTY_2, CeruleanCity_Gym_Text_MistyIntro, CeruleanCity_Gym_Text_MistyDefeat, Common_Text_NeedTwoPokemonForDoubleBattle, CeruleanCity_Gym_EventScript_MistyDefeated, NO_MUSIC
	end

CeruleanCity_Gym_EventScript_MistyChallenge3::
	trainerbattle_double TRAINER_LEADER_MISTY_3, CeruleanCity_Gym_Text_MistyIntro, CeruleanCity_Gym_Text_MistyDefeat, Common_Text_NeedTwoPokemonForDoubleBattle, CeruleanCity_Gym_EventScript_MistyDefeated, NO_MUSIC
	end

CeruleanCity_Gym_EventScript_MistyChallenge4::
	trainerbattle_double TRAINER_LEADER_MISTY_4, CeruleanCity_Gym_Text_MistyIntro, CeruleanCity_Gym_Text_MistyDefeat, Common_Text_NeedTwoPokemonForDoubleBattle, CeruleanCity_Gym_EventScript_MistyDefeated, NO_MUSIC
	end

CeruleanCity_Gym_EventScript_MistyChallenge5::
	trainerbattle_double TRAINER_LEADER_MISTY_5, CeruleanCity_Gym_Text_MistyIntro, CeruleanCity_Gym_Text_MistyDefeat, Common_Text_NeedTwoPokemonForDoubleBattle, CeruleanCity_Gym_EventScript_MistyDefeated, NO_MUSIC
	end

CeruleanCity_Gym_EventScript_MistyChallenge6::
	trainerbattle_double TRAINER_LEADER_MISTY_6, CeruleanCity_Gym_Text_MistyIntro, CeruleanCity_Gym_Text_MistyDefeat, Common_Text_NeedTwoPokemonForDoubleBattle, CeruleanCity_Gym_EventScript_MistyDefeated, NO_MUSIC
	end

CeruleanCity_Gym_EventScript_MistyChallenge7::
	trainerbattle_double TRAINER_LEADER_MISTY_7, CeruleanCity_Gym_Text_MistyIntro, CeruleanCity_Gym_Text_MistyDefeat, Common_Text_NeedTwoPokemonForDoubleBattle, CeruleanCity_Gym_EventScript_MistyDefeated, NO_MUSIC
	end

CeruleanCity_Gym_EventScript_MistyPostBattle::
	msgbox CeruleanCity_Gym_Text_MistyGyaradosReminder
	release
	end

CeruleanCity_Gym_EventScript_MistyDefeated::
	famechecker FAMECHECKER_MISTY, 1
	setflag FLAG_DEFEATED_MISTY
	setflag FLAG_BADGE02_GET
	setvar VAR_MISTY_TRIAL_STATE, 10
	setrespawn HEAL_LOCATION_CERULEAN_CITY
	goto CeruleanCity_Gym_EventScript_GiveCascadeBoard
	end

CeruleanCity_Gym_EventScript_GiveCascadeBoard::
	msgbox CeruleanCity_Gym_Text_TakeThisWithYou
	giveitem_msg CeruleanCity_Gym_Text_ReceivedCascadeBoardFromMisty, ITEM_CASCADE_BOARD, 1, MUS_OBTAIN_KEY_ITEM
	setflag FLAG_GOT_TM03_FROM_MISTY
	msgbox CeruleanCity_Gym_Text_ExplainCascadeBadge
	release
	end

CeruleanCity_Gym_EventScript_MistyGyaradosCheck::
	setvar VAR_0x8008, INGAME_TRADE_MISTY_POLIWHIRL
	call EventScript_GetInGameTradeSpeciesInfo
	goto_if_set FLAG_DID_MISTY_POLIWHIRL_TRADE, CeruleanCity_Gym_EventScript_MistyTradeDone
	msgbox CeruleanCity_Gym_Text_MistyOfferTrade, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, CeruleanCity_Gym_EventScript_MistyDeclineTrade
	call EventScript_ChooseMonForInGameTrade
	goto_if_ge VAR_0x8004, PARTY_SIZE, CeruleanCity_Gym_EventScript_MistyDeclineTrade
	call EventScript_GetInGameTradeSpecies
	goto_if_ne VAR_RESULT, VAR_0x8009, CeruleanCity_Gym_EventScript_MistyNotGyarados
	call EventScript_DoInGameTrade
	msgbox CeruleanCity_Gym_Text_MistyTradeComplete
	setflag FLAG_DID_MISTY_POLIWHIRL_TRADE
	setvar VAR_MISTY_TRIAL_STATE, 11
	completesubquest QUEST_GYM_LEADER_TRIALS, SUB_QUEST_MISTY
	release
	end

CeruleanCity_Gym_EventScript_MistyDeclineTrade::
	msgbox CeruleanCity_Gym_Text_MistyDeclineTrade
	release
	end

CeruleanCity_Gym_EventScript_MistyNotGyarados::
	msgbox CeruleanCity_Gym_Text_MistyNotGyarados
	release
	end

CeruleanCity_Gym_EventScript_MistyTradeDone::
	msgbox CeruleanCity_Gym_Text_MistyTradeDone
	release
	end

CeruleanCity_Gym_EventScript_Diana::
	trainerbattle_single TRAINER_PICNICKER_DIANA, CeruleanCity_Gym_Text_DianaIntro, CeruleanCity_Gym_Text_DianaDefeat
	msgbox CeruleanCity_Gym_Text_DianaPostBattle, MSGBOX_AUTOCLOSE
	end

CeruleanCity_Gym_EventScript_Luis::
	trainerbattle_single TRAINER_SWIMMER_MALE_LUIS, CeruleanCity_Gym_Text_LuisIntro, CeruleanCity_Gym_Text_LuisDefeat
	famechecker FAMECHECKER_MISTY, 2
	msgbox CeruleanCity_Gym_Text_LuisPostBattle, MSGBOX_AUTOCLOSE
	end

CeruleanCity_Gym_EventScript_GymGuy::
	lock
	faceplayer
	goto_if_set FLAG_DEFEATED_MISTY, CeruleanCity_Gym_EventScript_GymGuyPostVictory
	goto_if_eq VAR_MISTY_TRIAL_STATE, 0, CeruleanCity_Gym_EventScript_GymGuyMistyAwayFirstTime
	goto_if_eq VAR_MISTY_TRIAL_STATE, 1, CeruleanCity_Gym_EventScript_GymGuyMistyAwayRepeat
	goto_if_eq VAR_MISTY_TRIAL_STATE, 2, CeruleanCity_Gym_EventScript_GymGuyMistyAwayRepeat
	goto_if_eq VAR_MISTY_TRIAL_STATE, 3, CeruleanCity_Gym_EventScript_GymGuyMistyAwayRepeat
	goto_if_eq VAR_MISTY_TRIAL_STATE, 4, CeruleanCity_Gym_EventScript_GymGuyMistyAwayRepeat
	goto_if_eq VAR_MISTY_TRIAL_STATE, 5, CeruleanCity_Gym_EventScript_GymGuyMistyAwayRepeat
	goto_if_eq VAR_MISTY_TRIAL_STATE, 6, CeruleanCity_Gym_EventScript_GymGuyMistyAwayRepeat
	goto_if_eq VAR_MISTY_TRIAL_STATE, 7, CeruleanCity_Gym_EventScript_GymGuyMistyAwayRepeat
	goto_if_eq VAR_MISTY_TRIAL_STATE, 8, CeruleanCity_Gym_EventScript_GymGuyMistyAwayRepeat
	goto CeruleanCity_Gym_EventScript_GymGuyNormal

CeruleanCity_Gym_EventScript_GymGuyNormal::
	msgbox CeruleanCity_Gym_Text_MistyBackFromRockTunnel, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, YES, CeruleanCity_Gym_EventScript_GymGuyAdvice
	goto_if_eq VAR_RESULT, NO, CeruleanCity_Gym_EventScript_GymGuyDontNeedAdvice
	end

CeruleanCity_Gym_EventScript_GymGuyAdvice::
	msgbox CeruleanCity_Gym_Text_GymGuyLetsMakeWaves
	msgbox CeruleanCity_Gym_Text_GymGuyAdvice
	release
	end

CeruleanCity_Gym_EventScript_GymGuyDontNeedAdvice::
	msgbox CeruleanCity_Gym_Text_GymGuyShowMisty
	release
	end

CeruleanCity_Gym_EventScript_GymGuyMistyAwayFirstTime::
	msgbox CeruleanCity_Gym_Text_GymGuideMistyAway
	questmenu QUEST_MENU_UNLOCK_QUEST, QUEST_GYM_LEADER_TRIALS
	questmenu QUEST_MENU_SET_ACTIVE, QUEST_GYM_LEADER_TRIALS
	subquestmenu QUEST_MENU_UNLOCK_QUEST, QUEST_GYM_LEADER_TRIALS, SUB_QUEST_MISTY
	setvar VAR_MISTY_TRIAL_STATE, 1
	release
	end

CeruleanCity_Gym_EventScript_GymGuyMistyAwayRepeat::
	msgbox CeruleanCity_Gym_Text_GymGuideMistyStillAway
	release
	end

CeruleanCity_Gym_EventScript_GymGuyPostVictory::
	msgbox CeruleanCity_Gym_Text_WeMakePrettyGoodTeam
	release
	end

CeruleanCity_Gym_EventScript_GymStatue::
	lockall
	goto_if_set FLAG_BADGE02_GET, CeruleanCity_Gym_EventScript_GymStatuePostVictory
	msgbox CeruleanCity_Gym_Text_GymStatue
	releaseall
	end

CeruleanCity_Gym_EventScript_GymStatuePostVictory::
	msgbox CeruleanCity_Gym_Text_GymStatuePlayerWon
	releaseall
	end

CeruleanCity_Gym_Movement_GymGuideApproachEntrance::
	walk_right
	walk_down
	step_end

CeruleanCity_Gym_Movement_GymGuideReturnToSpot::
	walk_up
	walk_left
	walk_in_place_faster_down
	step_end
