CeruleanCity_Gym_MapScripts::
	.byte 0

CeruleanCity_Gym_EventScript_Misty::
	famechecker FAMECHECKER_MISTY, FCPICKSTATE_COLORED, UpdatePickStateFromSpecialVar8005
	goto_if_set FLAG_DEFEATED_MISTY, CeruleanCity_Gym_EventScript_MistyPostBattle
	special GetBadgeCount
	goto_if_eq VAR_RESULT, 0, CeruleanCity_Gym_EventScript_MistyChallenge1
	goto_if_eq VAR_RESULT, 1, CeruleanCity_Gym_EventScript_MistyChallenge2
	goto_if_eq VAR_RESULT, 2, CeruleanCity_Gym_EventScript_MistyChallenge3
	goto_if_eq VAR_RESULT, 3, CeruleanCity_Gym_EventScript_MistyChallenge4
	goto_if_eq VAR_RESULT, 4, CeruleanCity_Gym_EventScript_MistyChallenge5
	goto_if_eq VAR_RESULT, 5, CeruleanCity_Gym_EventScript_MistyChallenge6
	goto CeruleanCity_Gym_EventScript_MistyChallenge7

CeruleanCity_Gym_EventScript_MistyChallenge1::
	trainerbattle_double TRAINER_LEADER_MISTY_1, CeruleanCity_Gym_Text_MistyIntro, CeruleanCity_Gym_Text_MistyDefeat, Common_Text_NeedTwoPokemonForDoubleBattle, CeruleanCity_Gym_EventScript_MistyDefeated, NO_MUSIC
	end

CeruleanCity_Gym_EventScript_MistyChallenge2::
	trainerbattle_double TRAINER_LEADER_MISTY_2, CeruleanCity_Gym_Text_MistyIntro, CeruleanCity_Gym_Text_MistyDefeat, Common_Text_NeedTwoPokemonForDoubleBattle, CeruleanCity_Gym_EventScript_MistyDefeated, NO_MUSIC
	end

