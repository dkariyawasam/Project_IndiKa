CeladonCity_Gym_MapScripts::
	map_script MAP_SCRIPT_ON_FRAME_TABLE, CeladonCity_Gym_OnFrame
	map_script MAP_SCRIPT_ON_TRANSITION, CeladonCity_Gym_OnTransition
	.byte 0

CeladonCity_Gym_OnFrame::
	map_script_2 VAR_ERIKA_TRIAL_STATE, 0, CeladonCity_Gym_EventScript_GymGuideInterceptErikaAway
	.2byte 0

CeladonCity_Gym_OnTransition::
	goto_if_eq VAR_ERIKA_TRIAL_STATE, 0, CeladonCity_Gym_EventScript_SetInitialGuideState
	goto_if_ge VAR_ERIKA_TRIAL_STATE, 4, CeladonCity_Gym_EventScript_ShowErikaAndGuide
	setflag FLAG_HIDE_CELADON_CITY_GYM_GUIDE
	goto CeladonCity_Gym_EventScript_HideErika

CeladonCity_Gym_EventScript_ShowErikaAndGuide::
	clearflag FLAG_HIDE_CELADON_CITY_GYM_GUIDE
	clearflag FLAG_HIDE_CELADON_CITY_GYM_ERIKA
	end

CeladonCity_Gym_EventScript_SetInitialGuideState::
	clearflag FLAG_HIDE_CELADON_CITY_GYM_GUIDE
	goto CeladonCity_Gym_EventScript_HideErika

CeladonCity_Gym_EventScript_HideErika::
	setflag FLAG_HIDE_CELADON_CITY_GYM_ERIKA
	end

CeladonCity_Gym_EventScript_GymGuideInterceptErikaAway::
	lockall
	textcolor NPC_TEXT_COLOR_NEUTRAL
	playse SE_PIN
	applymovement LOCALID_CELADON_GYM_GUIDE, Common_Movement_ExclamationMark
	waitmovement 0
	applymovement LOCALID_CELADON_GYM_GUIDE, Common_Movement_Delay48
	waitmovement 0
	applymovement LOCALID_CELADON_GYM_GUIDE, CeladonCity_Gym_Movement_GymGuideApproachEntrance
	waitmovement 0
	applymovement LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterUp
	waitmovement 0
	msgbox CeladonCity_Gym_Text_GymGuideErikaAway
	logbookmenu LOGBOOK_MENU_UNLOCK_QUEST, QUEST_GYM_LEADER_TRIALS
	logbookmenu LOGBOOK_MENU_SET_ACTIVE, QUEST_GYM_LEADER_TRIALS
	sublogbookmenu LOGBOOK_MENU_UNLOCK_QUEST, QUEST_GYM_LEADER_TRIALS, SUB_QUEST_ERIKA
	setvar VAR_ERIKA_TRIAL_STATE, 1
	closemessage
	applymovement LOCALID_PLAYER, CeladonCity_Gym_Movement_PlayerStepAsideForGuide
	waitmovement 0
	applymovement LOCALID_CELADON_GYM_GUIDE, CeladonCity_Gym_Movement_GymGuideLeave
	waitmovement 0
	setflag FLAG_HIDE_CELADON_CITY_GYM_GUIDE
	removeobject LOCALID_CELADON_GYM_GUIDE
	releaseall
	end

CeladonCity_Gym_EventScript_Erika::
	lock
	faceplayer
	textcolor NPC_TEXT_COLOR_NEUTRAL
	goto_if_eq VAR_ERIKA_TRIAL_STATE, 4, CeladonCity_Gym_EventScript_ErikaReward
	goto_if_set FLAG_BADGE04_GET, CeladonCity_Gym_EventScript_ErikaPostReward
	msgbox CeladonCity_Gym_Text_ErikaWaitingForChallenge
	release
	end

CeladonCity_Gym_EventScript_ErikaReward::
	apexlog APEX_LOG_PERSON_ERIKA, 1
	clearflag FLAG_HIDE_APEX_LOG_ERIKA_JOURNALS
	setflag FLAG_DEFEATED_ERIKA
	setflag FLAG_BADGE04_GET
	msgbox CeladonCity_Gym_Text_ErikaReward
	goto CeladonCity_Gym_EventScript_ErikaBudewGift

CeladonCity_Gym_EventScript_ErikaBudewGift::
	goto_if_set FLAG_GOT_BUDEW_FROM_ERIKA, CeladonCity_Gym_EventScript_ErikaPostReward
	msgbox CeladonCity_Gym_Text_ErikaGiftBudew
	setvar VAR_TEMP_1, SPECIES_BUDEW
	givemon SPECIES_BUDEW, 30
	goto_if_eq VAR_RESULT, 0, CeladonCity_Gym_EventScript_ErikaReceiveBudewParty
	goto_if_eq VAR_RESULT, 1, CeladonCity_Gym_EventScript_ErikaReceiveBudewPC
	goto_if_eq VAR_RESULT, 2, EventScript_NoMoreRoomForPokemon
	release
	end

CeladonCity_Gym_EventScript_ErikaReceiveBudewParty::
	call EventScript_GetGiftMonPartySlot
	special SetPartyMonHighFriendship
	playfanfare MUS_LEVEL_UP
	message CeladonCity_Gym_Text_ReceivedBudewFromErika
	waitmessage
	waitfanfare
	bufferspeciesname STR_VAR_1, SPECIES_BUDEW
	msgbox Text_GiveNicknameToThisMon, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, CeladonCity_Gym_EventScript_ErikaSetGotBudew
	call EventScript_ChangePokemonNickname
	goto CeladonCity_Gym_EventScript_ErikaSetGotBudew
	end

CeladonCity_Gym_EventScript_ErikaReceiveBudewPC::
	special SetBoxMonHighFriendship
	playfanfare MUS_LEVEL_UP
	message CeladonCity_Gym_Text_ReceivedBudewFromErika
	waitmessage
	waitfanfare
	bufferspeciesname STR_VAR_1, SPECIES_BUDEW
	msgbox Text_GiveNicknameToThisMon, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, CeladonCity_Gym_EventScript_ErikaTransferBudewToPC
	call EventScript_NameReceivedBoxMon
	goto CeladonCity_Gym_EventScript_ErikaTransferBudewToPC
	end

CeladonCity_Gym_EventScript_ErikaTransferBudewToPC::
	call EventScript_TransferredToPC
	goto CeladonCity_Gym_EventScript_ErikaSetGotBudew
	end

CeladonCity_Gym_EventScript_ErikaSetGotBudew::
	setflag FLAG_GOT_BUDEW_FROM_ERIKA
	setvar VAR_ERIKA_TRIAL_STATE, 5
	msgbox CeladonCity_Gym_Text_ErikaBudewAdvice
	release
	end

CeladonCity_Gym_EventScript_ErikaPostReward::
	goto_if_ge VAR_ERIKA_TRIAL_STATE, 6, CeladonCity_Gym_EventScript_ErikaPostQuestComplete
	setvar VAR_0x8004, SPECIES_ROSELIA
	special Script_IsSpeciesCaught
	goto_if_eq VAR_RESULT, TRUE, CeladonCity_Gym_EventScript_ErikaConfirmRoselia
	msgbox CeladonCity_Gym_Text_ErikaRoseliaReminder
	release
	end

CeladonCity_Gym_EventScript_ErikaConfirmRoselia::
	setvar VAR_ERIKA_TRIAL_STATE, 6
	completesubquest QUEST_GYM_LEADER_TRIALS, SUB_QUEST_ERIKA
	msgbox CeladonCity_Gym_Text_ErikaRoseliaConfirmed
	release
	end

CeladonCity_Gym_EventScript_ErikaPostQuestComplete::
	msgbox CeladonCity_Gym_Text_ErikaPostBattle
	release
	end

CeladonCity_Gym_EventScript_ErikaBattleFallback::
	apexlog APEX_LOG_PERSON_ERIKA, APEX_LOG_PICK_STATE_COLORED, UpdatePickStateFromSpecialVar8005
	trainerbattle_double TRAINER_LEADER_ERIKA, CeladonCity_Gym_Text_ErikaIntro, CeladonCity_Gym_Text_ErikaDefeat, Common_Text_NeedTwoPokemonForDoubleBattle, CeladonCity_Gym_EventScript_DefeatedErika, NO_MUSIC
	apexlog APEX_LOG_PERSON_ERIKA, 4
	msgbox CeladonCity_Gym_Text_ErikaPostBattle
	release
	end

CeladonCity_Gym_EventScript_DefeatedErika::
	apexlog APEX_LOG_PERSON_ERIKA, 1
	clearflag FLAG_HIDE_APEX_LOG_ERIKA_JOURNALS
	setflag FLAG_DEFEATED_ERIKA
	setflag FLAG_BADGE04_GET
	setvar VAR_ERIKA_TRIAL_STATE, 5
	completesubquest QUEST_GYM_LEADER_TRIALS, SUB_QUEST_ERIKA
	msgbox CeladonCity_Gym_Text_ExplainRainbowBadgeTakeThis
	release
	end

CeladonCity_Gym_EventScript_GymGuide::
	lock
	faceplayer
	goto_if_eq VAR_ERIKA_TRIAL_STATE, 0, CeladonCity_Gym_EventScript_GymGuideErikaAwayFirstTime
	goto_if_ge VAR_ERIKA_TRIAL_STATE, 4, CeladonCity_Gym_EventScript_GymGuideErikaReturned
	msgbox CeladonCity_Gym_Text_GymGuideErikaStillAway
	release
	end

CeladonCity_Gym_EventScript_GymGuideErikaAwayFirstTime::
	msgbox CeladonCity_Gym_Text_GymGuideErikaAway
	logbookmenu LOGBOOK_MENU_UNLOCK_QUEST, QUEST_GYM_LEADER_TRIALS
	logbookmenu LOGBOOK_MENU_SET_ACTIVE, QUEST_GYM_LEADER_TRIALS
	sublogbookmenu LOGBOOK_MENU_UNLOCK_QUEST, QUEST_GYM_LEADER_TRIALS, SUB_QUEST_ERIKA
	setvar VAR_ERIKA_TRIAL_STATE, 1
	release
	end

CeladonCity_Gym_EventScript_GymGuideErikaReturned::
	goto_if_ge VAR_ERIKA_TRIAL_STATE, 5, CeladonCity_Gym_EventScript_GymGuidePostVictory
	msgbox CeladonCity_Gym_Text_GymGuideErikaImpressed
	release
	end

CeladonCity_Gym_EventScript_GymGuidePostVictory::
	msgbox CeladonCity_Gym_Text_GymGuidePostVictory
	release
	end

CeladonCity_Gym_EventScript_Kay::
	trainerbattle_single TRAINER_LASS_KAY, CeladonCity_Gym_Text_KayIntro, CeladonCity_Gym_Text_KayDefeat
	msgbox CeladonCity_Gym_Text_KayPostBattle, MSGBOX_AUTOCLOSE
	end

CeladonCity_Gym_EventScript_Lisa::
	trainerbattle_single TRAINER_LASS_LISA, CeladonCity_Gym_Text_LisaIntro, CeladonCity_Gym_Text_LisaDefeat
	apexlog APEX_LOG_PERSON_ERIKA, 2
	msgbox CeladonCity_Gym_Text_LisaPostBattle, MSGBOX_AUTOCLOSE
	end

CeladonCity_Gym_EventScript_Tina::
	trainerbattle_single TRAINER_TUBER_TINA, CeladonCity_Gym_Text_TinaIntro, CeladonCity_Gym_Text_TinaDefeat
	msgbox CeladonCity_Gym_Text_TinaPostBattle, MSGBOX_AUTOCLOSE
	end

CeladonCity_Gym_EventScript_Bridget::
	trainerbattle_single TRAINER_TRENDSETTERS_BRI_REMI, CeladonCity_Gym_Text_BridgetIntro, CeladonCity_Gym_Text_BridgetDefeat
	msgbox CeladonCity_Gym_Text_BridgetPostBattle, MSGBOX_AUTOCLOSE
	end

CeladonCity_Gym_EventScript_Tamia::
	trainerbattle_single TRAINER_TRENDSETTERS_TAMIA_LEO, CeladonCity_Gym_Text_TamiaIntro, CeladonCity_Gym_Text_TamiaDefeat
	apexlog APEX_LOG_PERSON_ERIKA, 3
	msgbox CeladonCity_Gym_Text_TamiaPostBattle, MSGBOX_AUTOCLOSE
	end

CeladonCity_Gym_EventScript_Lori::
	trainerbattle_single TRAINER_TRENDSETTER_LORI, CeladonCity_Gym_Text_LoriIntro, CeladonCity_Gym_Text_LoriDefeat
	msgbox CeladonCity_Gym_Text_LoriPostBattle, MSGBOX_AUTOCLOSE
	end

CeladonCity_Gym_EventScript_GymStatue::
	lockall
	goto_if_set FLAG_BADGE04_GET, CeladonCity_Gym_EventScript_GymStatuePostVictory
	msgbox CeladonCity_Gym_Text_GymStatue
	releaseall
	end

CeladonCity_Gym_EventScript_GymStatuePostVictory::
	msgbox CeladonCity_Gym_Text_GymStatuePlayerWon
	releaseall
	end

CeladonCity_Gym_Movement_GymGuideApproachEntrance::
	walk_left
	walk_down
	step_end

CeladonCity_Gym_Movement_PlayerStepAsideForGuide::
	walk_right
	walk_in_place_faster_left
	step_end

CeladonCity_Gym_Movement_GymGuideLeave::
	walk_down
	walk_down
	step_end
