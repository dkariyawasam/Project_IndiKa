RocketLeague_Arena_EventScript_FinishCoinReward::
	playse SE_SHOP
	waitse
	closemessage
	applymovement LOCALID_PLAYER, RocketLeague_Arena_Movement_StepBackFromArena
	waitmovement 0
	releaseall
	end

