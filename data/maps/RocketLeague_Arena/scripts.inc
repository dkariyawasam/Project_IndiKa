RocketLeague_Arena_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, RocketLeague_Arena_OnTransition
	map_script MAP_SCRIPT_ON_RESUME, RocketLeague_Arena_OnResume
	map_script MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE, RocketLeague_Arena_OnWarp
	.byte 0

RocketLeague_Arena_OnTransition::
	removeobject LOCALID_ROCKET_LEAGUE_ADMIN_M
	removeobject LOCALID_ROCKET_LEAGUE_ADMIN_F
	end

RocketLeague_Arena_OnResume::
	setvar VAR_0x8004, 2
	call PokemonLeague_EventScript_DoLightingEffect
	end

RocketLeague_Arena_OnWarp::
	map_script_2 VAR_TEMP_1, 0, RocketLeague_Arena_EventScript_TurnPlayerNorth
	.2byte 0

RocketLeague_Arena_EventScript_TurnPlayerNorth::
	turnobject LOCALID_PLAYER, DIR_NORTH
	end

RocketLeague_Arena_EventScript_Official::
	lock
	faceplayer
	msgbox RocketLeague_Arena_Text_Official
	release
	end

RocketLeague_Arena_EventScript_Admin::
	end

RocketLeague_Arena_EventScript_ReturnToLobby::
	special ResetLeagueChallenge
	setvar VAR_ROCKET_LEAGUE_PRIZE_TIER, 0
	warp MAP_ROCKET_LEAGUE_LOBBY, 9, 2
	waitstate
	end

RocketLeague_Arena_EventScript_TryEnterChampionRoom::
	lockall
	textcolor NPC_TEXT_COLOR_NEUTRAL
	special IsLeagueChallengeActive
	goto_if_eq VAR_RESULT, 0, RocketLeague_Arena_EventScript_ChampionRoomLocked
	special GetLeagueChallengeCurrentTrainer
	goto_if_eq VAR_RESULT, TRAINER_ROCKET_LEAGUE_CHAMPION_GIOVANNI, RocketLeague_Arena_EventScript_WarpToChampionRoom
	goto RocketLeague_Arena_EventScript_ChampionRoomLocked

RocketLeague_Arena_EventScript_WarpToChampionRoom::
	warp MAP_ROCKET_LEAGUE_CHAMPIONS_ROOM, 6, 19
	waitstate
	releaseall
	end

RocketLeague_Arena_EventScript_ChampionRoomLocked::
	msgbox RocketLeague_Arena_Text_ChampionRoomLocked
	closemessage
	applymovement LOCALID_PLAYER, RocketLeague_Arena_Movement_StepBackFromChampionRoom
	waitmovement 0
	releaseall
	end

RocketLeague_Arena_EventScript_ReadyPrompt::
	lockall
	textcolor NPC_TEXT_COLOR_NEUTRAL
	msgbox RocketLeague_Arena_Text_AreYouReady, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, YES, RocketLeague_Arena_EventScript_StartRocketBattle
	closemessage
	applymovement LOCALID_PLAYER, RocketLeague_Arena_Movement_StepBackFromArena
	waitmovement 0
	releaseall
	end

RocketLeague_Arena_EventScript_StartRocketBattle::
	closemessage
	special IsLeagueChallengeActive
	call_if_eq VAR_RESULT, 0, RocketLeague_Arena_EventScript_StartChallenge
	special GetLeagueChallengeCurrentTrainer
	goto_if_eq VAR_RESULT, TRAINER_ROCKET_ADMIN_PETREL, RocketLeague_Arena_EventScript_BattlePetrel
	goto_if_eq VAR_RESULT, TRAINER_ROCKET_ADMIN_ARCHER, RocketLeague_Arena_EventScript_BattleArcher
	goto_if_eq VAR_RESULT, TRAINER_ROCKET_ADMIN_ARIANA, RocketLeague_Arena_EventScript_BattleAriana
	goto_if_eq VAR_RESULT, TRAINER_ROCKET_ADMIN_PROTON, RocketLeague_Arena_EventScript_BattleProton
	goto_if_eq VAR_RESULT, TRAINER_ROCKET_ACE_RAZOR, RocketLeague_Arena_EventScript_BattleRazor
	goto_if_eq VAR_RESULT, TRAINER_ROCKET_ACE_VEX, RocketLeague_Arena_EventScript_BattleVex
	goto_if_eq VAR_RESULT, TRAINER_ROCKET_ACE_NOVA, RocketLeague_Arena_EventScript_BattleNova
	goto_if_eq VAR_RESULT, TRAINER_ROCKET_ACE_KNELL, RocketLeague_Arena_EventScript_BattleKnell
	goto_if_eq VAR_RESULT, TRAINER_ROCKET_ACE_MAKO, RocketLeague_Arena_EventScript_BattleMako
	goto_if_eq VAR_RESULT, TRAINER_ROCKET_ACE_SABLE, RocketLeague_Arena_EventScript_BattleSable
	goto_if_eq VAR_RESULT, TRAINER_ROCKET_ACE_JET, RocketLeague_Arena_EventScript_BattleJet
	goto_if_eq VAR_RESULT, TRAINER_ROCKET_ACE_VIPER, RocketLeague_Arena_EventScript_BattleViper
	goto_if_eq VAR_RESULT, TRAINER_ROCKET_LEAGUE_CHAMPION_GIOVANNI, RocketLeague_Arena_EventScript_ChampionAwaits
	call RocketLeague_Arena_EventScript_StartChallenge
	goto RocketLeague_Arena_EventScript_StartRocketBattle

RocketLeague_Arena_EventScript_StartChallenge::
	special StartRocketLeagueChallenge
	return

RocketLeague_Arena_EventScript_BattlePetrel::
	call RocketLeague_Arena_EventScript_AdminMEnter
	textcolor NPC_TEXT_COLOR_NEUTRAL
	msgbox RocketLeague_Arena_Text_PetrelIntro
	playbgm MUS_ENCOUNTER_ROCKET, 0
	cleartrainerflag TRAINER_ROCKET_ADMIN_PETREL
	trainerbattle_no_intro TRAINER_ROCKET_ADMIN_PETREL, RocketLeague_Arena_Text_PetrelDefeat
	msgbox RocketLeague_Arena_Text_PetrelPostBattle
	special AdvanceLeagueChallengeRound
	call RocketLeague_Arena_EventScript_AdminMExit
	goto RocketLeague_Arena_EventScript_GiveCoinReward

