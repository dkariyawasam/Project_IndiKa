	end

RocketLeague_Arena_Movement_StepBackFromArena::
	walk_down
	step_end

RocketLeague_Arena_Movement_StepBackFromChampionRoom::
	walk_down
	step_end

RocketLeague_Arena_Movement_AdminEnter::
	walk_down
	walk_down
	walk_down
	walk_down
	step_end

RocketLeague_Arena_Movement_AdminExit::
	walk_up
	walk_up
	walk_up
	walk_up
	step_end
