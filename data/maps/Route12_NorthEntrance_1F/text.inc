Route12_NorthEntrance_1F_Text_RentalActive::
    .string "Your rental BICYCLE is ready.\p"
    .string "Ride along Routes 14 and 15,\n"
    .string "then return it at either gate.$"

Route12_NorthEntrance_1F_Text_OwnBike::
    .string "You've got your own BICYCLE.\p"
    .string "You're free to ride ahead.$"

Route12_NorthEntrance_1F_Text_NotEnoughMoney::
