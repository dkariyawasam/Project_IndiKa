	step_end

Route12_NorthEntrance_1F_EventScript_ReturnBikeAtCarpet::
	lockall
	goto Route12_NorthEntrance_1F_EventScript_ReturnBikeTrigger

Route12_NorthEntrance_1F_Movement_ReturnFromCarpet::
	walk_up
	walk_up
	walk_left
	walk_left
	walk_in_place_faster_left
	step_end

