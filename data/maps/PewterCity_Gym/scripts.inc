PewterCity_Gym_MapScripts::
	map_script MAP_SCRIPT_ON_FRAME_TABLE, PewterCity_Gym_OnFrame
	.byte 0

PewterCity_Gym_OnFrame::
	map_script_2 VAR_BROCK_TRIAL_STATE, 0, PewterCity_Gym_EventScript_GymGuyInterceptBrockAway
	.2byte 0

PewterCity_Gym_EventScript_GymGuyInterceptBrockAway::
	lockall
	textcolor NPC_TEXT_COLOR_NEUTRAL
	playse SE_PIN
	applymovement LOCALID_PEWTER_GYM_GUY, Common_Movement_ExclamationMark
	waitmovement 0
	applymovement LOCALID_PEWTER_GYM_GUY, Common_Movement_Delay48
	waitmovement 0
	applymovement LOCALID_PEWTER_GYM_GUY, PewterCity_Gym_Movement_GymGuyApproachEntrance
	waitmovement 0
	applymovement LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterUp
	waitmovement 0
	msgbox PewterCity_Gym_Text_GymGuyBrockInMtMoon
	questmenu QUEST_MENU_UNLOCK_QUEST, QUEST_GYM_LEADER_TRIALS
	questmenu QUEST_MENU_SET_ACTIVE, QUEST_GYM_LEADER_TRIALS
	subquestmenu QUEST_MENU_UNLOCK_QUEST, QUEST_GYM_LEADER_TRIALS, SUB_QUEST_BROCK
	setvar VAR_BROCK_TRIAL_STATE, 1
	closemessage
	applymovement LOCALID_PEWTER_GYM_GUY, PewterCity_Gym_Movement_GymGuyReturnToSpot
	waitmovement 0
	releaseall
	end

PewterCity_Gym_EventScript_Brock::
	famechecker FAMECHECKER_BROCK, FCPICKSTATE_COLORED, UpdatePickStateFromSpecialVar8005
	goto_if_eq VAR_BROCK_TRIAL_STATE, 3, PewterCity_Gym_EventScript_BrockBattlePicker
	goto_if_eq VAR_BROCK_TRIAL_STATE, 4, PewterCity_Gym_EventScript_BrockRelicanthCheck
	goto_if_eq VAR_BROCK_TRIAL_STATE, 5, PewterCity_Gym_EventScript_BrockTradeDone
	msgbox PewterCity_Gym_Text_BrockPostBattle
	release
	end

PewterCity_Gym_EventScript_BrockBattlePicker::
	special GetBadgeCount
	goto_if_eq VAR_RESULT, 0, PewterCity_Gym_EventScript_BrockBattlNoBadges
	goto_if_eq VAR_RESULT, 1, PewterCity_Gym_EventScript_BrockBattlOneBadge
	goto_if_eq VAR_RESULT, 2, PewterCity_Gym_EventScript_BrockBattlTwoBadges
	goto_if_eq VAR_RESULT, 3, PewterCity_Gym_EventScript_BrockBattlThreeBadges
	goto_if_eq VAR_RESULT, 4, PewterCity_Gym_EventScript_BrockBattlFourBadges
	goto_if_eq VAR_RESULT, 5, PewterCity_Gym_EventScript_BrockBattlFiveBadges
	goto PewterCity_Gym_EventScript_BrockBattlSixBadges

PewterCity_Gym_EventScript_BrockBattlNoBadges::
	trainerbattle_double TRAINER_LEADER_BROCK_1, PewterCity_Gym_Text_BrockIntro, PewterCity_Gym_Text_BrockDefeat, PewterCity_Gym_Text_BrockNotEnoughPokemon, PewterCity_Gym_EventScript_DefeatedBrock, NO_MUSIC
	end

PewterCity_Gym_EventScript_BrockBattlOneBadge::
	trainerbattle_double TRAINER_LEADER_BROCK_2, PewterCity_Gym_Text_BrockIntro, PewterCity_Gym_Text_BrockDefeat, PewterCity_Gym_Text_BrockNotEnoughPokemon, PewterCity_Gym_EventScript_DefeatedBrock, NO_MUSIC
	end

PewterCity_Gym_EventScript_BrockBattlTwoBadges::
	trainerbattle_double TRAINER_LEADER_BROCK_3, PewterCity_Gym_Text_BrockIntro, PewterCity_Gym_Text_BrockDefeat, PewterCity_Gym_Text_BrockNotEnoughPokemon, PewterCity_Gym_EventScript_DefeatedBrock, NO_MUSIC
	end

PewterCity_Gym_EventScript_BrockBattlThreeBadges::
	trainerbattle_double TRAINER_LEADER_BROCK_4, PewterCity_Gym_Text_BrockIntro, PewterCity_Gym_Text_BrockDefeat, PewterCity_Gym_Text_BrockNotEnoughPokemon, PewterCity_Gym_EventScript_DefeatedBrock, NO_MUSIC
	end

PewterCity_Gym_EventScript_BrockBattlFourBadges::
	trainerbattle_double TRAINER_LEADER_BROCK_5, PewterCity_Gym_Text_BrockIntro, PewterCity_Gym_Text_BrockDefeat, PewterCity_Gym_Text_BrockNotEnoughPokemon, PewterCity_Gym_EventScript_DefeatedBrock, NO_MUSIC
	end

PewterCity_Gym_EventScript_BrockBattlFiveBadges::
	trainerbattle_double TRAINER_LEADER_BROCK_6, PewterCity_Gym_Text_BrockIntro, PewterCity_Gym_Text_BrockDefeat, PewterCity_Gym_Text_BrockNotEnoughPokemon, PewterCity_Gym_EventScript_DefeatedBrock, NO_MUSIC
	end

PewterCity_Gym_EventScript_BrockBattlSixBadges::
	trainerbattle_double TRAINER_LEADER_BROCK_7, PewterCity_Gym_Text_BrockIntro, PewterCity_Gym_Text_BrockDefeat, PewterCity_Gym_Text_BrockNotEnoughPokemon, PewterCity_Gym_EventScript_DefeatedBrock, NO_MUSIC
	end

PewterCity_Gym_EventScript_DefeatedBrock::
	famechecker FAMECHECKER_BROCK, 1
	setflag FLAG_DEFEATED_BROCK
	setflag FLAG_BADGE01_GET
	setvar VAR_MAP_SCENE_PEWTER_CITY, 1
	setflag FLAG_HIDE_PEWTER_CITY_GYM_GUIDE
	goto PewterCity_Gym_EventScript_GiveBoulderBadge
	end

PewterCity_Gym_EventScript_GiveBoulderBadge::
	msgbox PewterCity_Gym_Text_TakeThisWithYou
	giveitem_msg PewterCity_Gym_Text_ReceivedBoulderKeyFromBrock, ITEM_BOULDER_KEY, 1, MUS_OBTAIN_KEY_ITEM
	msgbox PewterCity_Gym_Text_ExplainBoulderBadge
	setvar VAR_BROCK_TRIAL_STATE, 4
	release
	end

PewterCity_Gym_EventScript_BrockRelicanthCheck::
	setvar VAR_0x8008, INGAME_TRADE_BROCK_GRAVELER
	call EventScript_GetInGameTradeSpeciesInfo
	goto_if_set FLAG_DID_BROCK_GRAVELER_TRADE, PewterCity_Gym_EventScript_BrockTradeDone
	msgbox PewterCity_Gym_Text_BrockOfferTrade, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, PewterCity_Gym_EventScript_BrockDeclineTrade
	call EventScript_ChooseMonForInGameTrade
	goto_if_ge VAR_0x8004, PARTY_SIZE, PewterCity_Gym_EventScript_BrockDeclineTrade
	call EventScript_GetInGameTradeSpecies
	goto_if_ne VAR_RESULT, VAR_0x8009, PewterCity_Gym_EventScript_BrockNotRelicanth
	call EventScript_DoInGameTrade
	msgbox PewterCity_Gym_Text_BrockTradeComplete
	setflag FLAG_DID_BROCK_GRAVELER_TRADE
	setvar VAR_BROCK_TRIAL_STATE, 5
	completesubquest QUEST_GYM_LEADER_TRIALS, SUB_QUEST_BROCK
	release
	end

PewterCity_Gym_EventScript_BrockDeclineTrade::
	msgbox PewterCity_Gym_Text_BrockDeclineTrade
	release
	end
PewterCity_Gym_EventScript_BrockNotRelicanth::
	msgbox PewterCity_Gym_Text_BrockNotRelicanth
	release
	end

PewterCity_Gym_EventScript_BrockTradeDone::
	msgbox PewterCity_Gym_Text_BrockTradeDone
	release
	end

PewterCity_Gym_EventScript_GymGuy::
	lock
	faceplayer
	goto_if_set FLAG_DEFEATED_BROCK, PewterCity_Gym_EventScript_GymGuyPostVictory
	goto_if_eq VAR_BROCK_TRIAL_STATE, 0, PewterCity_Gym_EventScript_GymGuyBrockAwayFirstTime
	goto_if_eq VAR_BROCK_TRIAL_STATE, 1, PewterCity_Gym_EventScript_GymGuyBrockAwayRepeat
	goto_if_eq VAR_BROCK_TRIAL_STATE, 2, PewterCity_Gym_EventScript_GymGuyBrockAwayRepeat
	goto PewterCity_Gym_EventScript_GymGuyNormal

PewterCity_Gym_EventScript_GymGuyBrockAwayFirstTime::
	msgbox PewterCity_Gym_Text_GymGuyBrockInMtMoon
	questmenu QUEST_MENU_UNLOCK_QUEST, QUEST_GYM_LEADER_TRIALS
	questmenu QUEST_MENU_SET_ACTIVE, QUEST_GYM_LEADER_TRIALS
	subquestmenu QUEST_MENU_UNLOCK_QUEST, QUEST_GYM_LEADER_TRIALS, SUB_QUEST_BROCK
	setvar VAR_BROCK_TRIAL_STATE, 1
	release
	end

PewterCity_Gym_EventScript_GymGuyBrockAwayRepeat::
	msgbox PewterCity_Gym_Text_GymGuyBrockStillAway
	release
	end

PewterCity_Gym_EventScript_GymGuyNormal::
	msgbox PewterCity_Gym_Text_LetMeTakeYouToTheTop, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, YES, PewterCity_Gym_EventScript_GymGuyTakeMeToTop
	goto_if_eq VAR_RESULT, NO, PewterCity_Gym_EventScript_GymGuyDontTakeMeToTop
	end

PewterCity_Gym_EventScript_GymGuyPostVictory::
	msgbox PewterCity_Gym_Text_YoureChampMaterial
	release
	end

PewterCity_Gym_EventScript_GymGuyTakeMeToTop::
	msgbox PewterCity_Gym_Text_LetsGetHappening
	goto PewterCity_Gym_EventScript_GymGuyAdvice
	end

PewterCity_Gym_EventScript_GymGuyDontTakeMeToTop::
	msgbox PewterCity_Gym_Text_ItsFreeLetsGetHappening
	release
	end

PewterCity_Gym_EventScript_GymGuyAdvice::
	msgbox PewterCity_Gym_Text_BrockTypeAdvice
	release
	end

PewterCity_Gym_EventScript_GymStatue::
	lockall
	goto_if_set FLAG_BADGE01_GET, PewterCity_Gym_EventScript_GymStatuePostVictory
	msgbox PewterCity_Gym_Text_GymStatue
	releaseall
	end

PewterCity_Gym_EventScript_GymStatuePostVictory::
	msgbox PewterCity_Gym_Text_GymStatuePlayerWon
	releaseall
	end

PewterCity_Gym_Movement_GymGuyApproachEntrance::
	walk_left
	walk_down
	step_end

PewterCity_Gym_Movement_GymGuyReturnToSpot::
	walk_up
	walk_right
	walk_in_place_faster_down
	step_end
