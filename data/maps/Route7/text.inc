Route7_Text_UndergroundPathSign::
    .string "UNDERGROUND PATH\n"
    .string "CELADON CITY - LAVENDER TOWN$"

Route7_Text_LoreleiAftermath::
	.string "LORELEI: You're late.\n"
	.string "We all were.\p"
	.string "It tore through here\n"
	.string "under GIOVANNI's command...$"

Route7_Text_LoreleiFlashback::
	.string "GIOVANNI: MEWTWO.\p"
	.string "Destroy the ELITE FOUR.\n"
	.string "Show them perfected power.$"

Route7_Text_LoreleiFlashbackFire::
	.string "LORELEI: MEWTWO!\n"
	.string "Stop!$"

Route7_Text_LoreleiFlashbackSignal::
	.string "GIOVANNI: The signal holds.\n"
	.string "Fire.$"

Route7_Text_LoreleiRepeat::
	.string "LORELEI: That is what I saw.\p"
	.string "Power without trust only\n"
	.string "becomes another storm.$"

Route7_Text_BrunoAftermath::
	.string "BRUNO: I met it head-on.\p"
	.string "Foolish.\p"
	.string "It pushed through me like\n"
	.string "I was mist.$"

Route7_Text_BrunoFlashbackChallenge::
	.string "BRUNO: Hah!\n"
	.string "Then strike me!$"

Route7_Text_BrunoRepeat::
	.string "BRUNO: I felt no discipline\n"
	.string "in that power.\p"
	.string "Only pressure.$"

Route7_Text_AgathaAftermath::
	.string "AGATHA: That man thought\n"
	.string "control was the same as\l"
	.string "trust.\p"
	.string "Always the same mistake.$"

Route7_Text_AgathaFlashback::
	.string "AGATHA: You don't command\n"
	.string "a spirit like that.\p"
	.string "GIOVANNI: It is not spirit.\n"
	.string "It is power.$"

Route7_Text_AgathaRepeat::
	.string "AGATHA: He learned nothing.\p"
	.string "MEWTWO learned faster.$"

Route7_Text_LanceAftermath::
	.string "LANCE: We slowed it,\n"
	.string "barely.\p"
	.string "Then it turned on the signal\n"
	.string "itself.$"

Route7_Text_LanceFlashback::
	.string "LANCE: GIOVANNI!\n"
	.string "Release it!\p"
	.string "MEWTWO: GYAAOOO!\p"
	.string "The device shattered.\n"
	.string "MEWTWO fled north.$"

Route7_Text_LanceRepeat::
	.string "LANCE: It escaped toward\n"
	.string "CERULEAN.\p"
	.string "I doubt it will let anyone\n"
	.string "near it now.$"

Route7_Text_Route7FindTheCave::
	.string "The accounts point toward\n"
	.string "the cave carved by the blast.$"

Route7_Text_GiovanniChasingMewtwo::
	.string "GIOVANNI: MEWTWO!\p"
	.string "You will not slip from my\n"
	.string "grasp again!$"

Route7_Text_Route7FullPicture::
	.string "The pieces fit together.\p"
	.string "GIOVANNI controlled MEWTWO\n"
	.string "long enough to force a path\l"
	.string "north...\p"
	.string "But MEWTWO broke free and\n"
	.string "escaped toward CERULEAN\l"
	.string "CAVE.$"
