	setvar VAR_RESULT, 0
	goto_if_lt VAR_ROUTE3_RIVAL_CONVERSATION, 1, EventScript_Return
	goto_if_lt VAR_MAP_SCENE_CELADON_RIVAL, 1, EventScript_Return
	goto_if_lt VAR_ROUTE23_RIVAL_CONVERSATION, 1, EventScript_Return
	goto_if_lt VAR_MAP_SCENE_CINNABAR_RIVAL, 1, EventScript_Return
	goto_if_lt VAR_MAP_SCENE_POKEMON_MANSION_3F_RIVAL, 1, EventScript_Return
	goto_if_lt VAR_MAP_SCENE_SILPH_CO_7F, 1, EventScript_Return
	goto_if_lt VAR_MAP_SCENE_ROUTE11_RIVAL, 1, EventScript_Return
	goto_if_lt VAR_MAP_SCENE_POKEMON_TOWER_1F, 1, EventScript_Return
