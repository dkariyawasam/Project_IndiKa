PokemonTower_2F_MapScripts::
	.byte 0

PokemonTower_2F_EventScript_Patricia::
	trainerbattle_single TRAINER_CHANNELER_PATRICIA, PokemonTower_2F_Text_PatriciaIntro, PokemonTower_2F_Text_PatriciaDefeat
	specialvar VAR_RESULT, ShouldTryRematchBattle
	goto_if_eq VAR_RESULT, TRUE, PokemonTower_2F_EventScript_PatriciaRematch
	msgbox PokemonTower_2F_Text_PatriciaPostBattle, MSGBOX_AUTOCLOSE
	end

PokemonTower_2F_EventScript_PatriciaRematch::
	trainerbattle_rematch TRAINER_CHANNELER_PATRICIA, PokemonTower_2F_Text_PatriciaIntro, PokemonTower_2F_Text_PatriciaDefeat
	msgbox PokemonTower_2F_Text_PatriciaPostBattle, MSGBOX_AUTOCLOSE
	end

