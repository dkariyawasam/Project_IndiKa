ViridianForest_EventScript_NeedTwoPokemon::
	msgbox Common_Text_NeedTwoPokemonForDoubleBattle
	release
	end

ViridianForest_EventScript_DefeatedErika::
	famechecker FAMECHECKER_ERIKA, 1
	clearflag FLAG_HIDE_FAME_CHECKER_ERIKA_JOURNALS
	setflag FLAG_DEFEATED_ERIKA
	setflag FLAG_BADGE04_GET
	setvar VAR_ERIKA_TRIAL_STATE, 4
	msgbox ViridianForest_Text_ErikaAfterBattle
	additem ITEM_RAINBOW_KEY
	closemessage
	applymovement LOCALID_VIRIDIAN_FOREST_ERIKA, ViridianForest_Movement_ErikaLeave
	applymovement LOCALID_VIRIDIAN_FOREST_GYM_GUIDE, ViridianForest_Movement_GymGuideLeave
	waitmovement 0
	removeobject LOCALID_VIRIDIAN_FOREST_ERIKA
	removeobject LOCALID_VIRIDIAN_FOREST_GYM_GUIDE
	setflag FLAG_HIDE_VIRIDIAN_FOREST_ERIKA
	setflag FLAG_HIDE_CELADON_CITY_GYM_GUIDE
	release
	end

ViridianForest_EventScript_GymGuide::
	msgbox ViridianForest_Text_GymGuideFoundErika, MSGBOX_NPC
	end

ViridianForest_EventScript_ExitSign::
	msgbox ViridianForest_Text_LeavingViridianForest, MSGBOX_SIGN
	end

ViridianForest_EventScript_Tangrowth::
	goto_if_questlog EventScript_ReleaseEnd
	special QuestLog_CutRecording
	lock
	faceplayer
	seteventmon SPECIES_TANGROWTH, 50
	call EventScript_ApexEncounterShake
	playmoncry SPECIES_TANGROWTH, CRY_MODE_ENCOUNTER
	message ViridianForest_Text_TangrowthApexCry
	waitmessage
	waitmoncry
	delay 10
	playbgm MUS_ENCOUNTER_GYM_LEADER, 0
	waitbuttonpress
	setflag FLAG_INTERACTED_APEX_TANGROWTH
	special TryCompleteApexInstinctQuest
	setflag FLAG_SYS_SPECIAL_WILD_BATTLE
	special StartApexBattle
	waitstate
	clearflag FLAG_SYS_SPECIAL_WILD_BATTLE
	specialvar VAR_RESULT, GetBattleOutcome
	goto_if_eq VAR_RESULT, B_OUTCOME_WON, ViridianForest_EventScript_DefeatedTangrowth
	goto_if_eq VAR_RESULT, B_OUTCOME_RAN, ViridianForest_EventScript_RanFromTangrowth
	goto_if_eq VAR_RESULT, B_OUTCOME_PLAYER_TELEPORTED, ViridianForest_EventScript_RanFromTangrowth
	setflag FLAG_FOUGHT_TANGROWTH
	setflag FLAG_HIDE_VIRIDIAN_FOREST_TANGROWTH
	release
	end

ViridianForest_EventScript_DefeatedTangrowth::
	setflag FLAG_FOUGHT_TANGROWTH
	setflag FLAG_HIDE_VIRIDIAN_FOREST_TANGROWTH
	goto EventScript_RemoveStaticMon
	end

ViridianForest_EventScript_RanFromTangrowth::
	fadescreen FADE_TO_BLACK
	removeobject VAR_LAST_TALKED
	fadescreen FADE_FROM_BLACK
	msgbox ViridianForest_Text_TangrowthVanished
	release
	end

