ViridianForest_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, ViridianForest_OnTransition
	map_script MAP_SCRIPT_ON_RESUME, ViridianForest_OnResume
	.byte 0

ViridianForest_OnResume::
	call_if_set FLAG_SYS_SPECIAL_WILD_BATTLE, ViridianForest_EventScript_TryRemoveTangrowth
	end

ViridianForest_EventScript_TryRemoveTangrowth::
	specialvar VAR_RESULT, GetBattleOutcome
	goto_if_ne VAR_RESULT, B_OUTCOME_CAUGHT, EventScript_Return
	removeobject VAR_LAST_TALKED
	return

ViridianForest_OnTransition::
	setworldmapflag FLAG_WORLD_MAP_VIRIDIAN_FOREST
	setflag FLAG_HIDE_CELADON_CITY_GYM_GUIDE
	call_if_unset FLAG_FOUGHT_TANGROWTH, ViridianForest_EventScript_ShowTangrowth
	call_if_set FLAG_FOUGHT_TANGROWTH, ViridianForest_EventScript_HideTangrowth
	goto_if_ge VAR_ERIKA_TRIAL_STATE, 4, ViridianForest_EventScript_RemoveErika
	clearflag FLAG_HIDE_VIRIDIAN_FOREST_ERIKA
	end

ViridianForest_EventScript_ShowTangrowth::
	removeobject LOCALID_VIRIDIAN_FOREST_TANGROWTH
	setobjectgfx LOCALID_VIRIDIAN_FOREST_TANGROWTH, OBJ_EVENT_GFX_TANGROWTH
	clearflag FLAG_HIDE_VIRIDIAN_FOREST_TANGROWTH
	addobject LOCALID_VIRIDIAN_FOREST_TANGROWTH
	return

ViridianForest_EventScript_HideTangrowth::
	setflag FLAG_HIDE_VIRIDIAN_FOREST_TANGROWTH
	return

ViridianForest_EventScript_RemoveErika::
	setflag FLAG_HIDE_VIRIDIAN_FOREST_ERIKA
	removeobject LOCALID_VIRIDIAN_FOREST_ERIKA
	end

ViridianForest_EventScript_Youngster::
	msgbox ViridianForest_Text_FriendsItchingToBattle, MSGBOX_NPC
	end

ViridianForest_EventScript_Boy::
	msgbox ViridianForest_Text_RanOutOfPokeBalls, MSGBOX_NPC
	end

ViridianForest_EventScript_Erika::
	lock
	faceplayer
	textcolor NPC_TEXT_COLOR_NEUTRAL
	goto_if_ge VAR_ERIKA_TRIAL_STATE, 4, ViridianForest_EventScript_ErikaReturnToGym
	questmenu QUEST_MENU_UNLOCK_QUEST, QUEST_GYM_LEADER_TRIALS
	questmenu QUEST_MENU_SET_ACTIVE, QUEST_GYM_LEADER_TRIALS
	subquestmenu QUEST_MENU_UNLOCK_QUEST, QUEST_GYM_LEADER_TRIALS, SUB_QUEST_ERIKA
	goto_if_eq VAR_ERIKA_TRIAL_STATE, 3, ViridianForest_EventScript_ErikaAskChallenge
	goto_if_ge VAR_ERIKA_TRIAL_STATE, 2, ViridianForest_EventScript_ErikaCheckForRoot
	setvar VAR_ERIKA_TRIAL_STATE, 2
	msgbox ViridianForest_Text_ErikaLookingForRoot
	release
	end

ViridianForest_EventScript_ErikaCheckForRoot::
	checkitem ITEM_ENERGY_ROOT, 1
	goto_if_eq VAR_RESULT, TRUE, ViridianForest_EventScript_ErikaHasRoot
	msgbox ViridianForest_Text_ErikaLookingForRoot
	release
	end

ViridianForest_EventScript_ErikaReturnToGym::
	setflag FLAG_HIDE_VIRIDIAN_FOREST_ERIKA
	removeobject LOCALID_VIRIDIAN_FOREST_ERIKA
	release
	end

ViridianForest_EventScript_ErikaHasRoot::
	msgbox ViridianForest_Text_ErikaShownRoot
	setvar VAR_ERIKA_TRIAL_STATE, 3
	special HasEnoughMonsForDoubleBattle
	goto_if_ne VAR_RESULT, PLAYER_HAS_TWO_USABLE_MONS, ViridianForest_EventScript_NeedTwoPokemon
	goto_if_unset FLAG_HIDE_CELADON_CITY_GYM_GUIDE, ViridianForest_EventScript_ErikaAskChallenge
	closemessage
	applymovement LOCALID_PLAYER, ViridianForest_Movement_PlayerStepAsideForGuide
	waitmovement 0
	clearflag FLAG_HIDE_CELADON_CITY_GYM_GUIDE
	addobject LOCALID_VIRIDIAN_FOREST_GYM_GUIDE
	applymovement LOCALID_VIRIDIAN_FOREST_GYM_GUIDE, ViridianForest_Movement_GymGuideArrive
	waitmovement 0
	msgbox ViridianForest_Text_GymGuideFoundErika

ViridianForest_EventScript_ErikaAskChallenge::
	msgbox ViridianForest_Text_ErikaChallenge, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, ViridianForest_EventScript_ErikaDeclineChallenge
	goto ViridianForest_EventScript_ErikaBattlePicker
	end

ViridianForest_EventScript_ErikaDeclineChallenge::
	release
	end

ViridianForest_EventScript_ErikaBattlePicker::
	special GetBadgeCount
	goto_if_eq VAR_RESULT, 0, ViridianForest_EventScript_ErikaChallenge1
	goto_if_eq VAR_RESULT, 1, ViridianForest_EventScript_ErikaChallenge2
	goto_if_eq VAR_RESULT, 2, ViridianForest_EventScript_ErikaChallenge3
	goto_if_eq VAR_RESULT, 3, ViridianForest_EventScript_ErikaChallenge4
	goto_if_eq VAR_RESULT, 4, ViridianForest_EventScript_ErikaChallenge5
	goto_if_eq VAR_RESULT, 5, ViridianForest_EventScript_ErikaChallenge6
	goto ViridianForest_EventScript_ErikaChallenge7

ViridianForest_EventScript_ErikaChallenge1::
	trainerbattle_double TRAINER_LEADER_ERIKA_1, ViridianForest_Text_ErikaBattleIntro, ViridianForest_Text_ErikaDefeat, Common_Text_NeedTwoPokemonForDoubleBattle, ViridianForest_EventScript_DefeatedErika, NO_MUSIC
	release
	end

