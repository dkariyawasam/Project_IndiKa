SilphCo_11F_MapScripts::
	map_script MAP_SCRIPT_ON_LOAD, SilphCo_11F_OnLoad
	.byte 0

SilphCo_11F_OnLoad::
	call EventScript_UpdateSaffronRocketTakeoverState
	call_if_unset FLAG_SILPH_11F_DOOR, EventScript_Close11FDoor
	end

SilphCo_11F_EventScript_President::
	lock
	faceplayer
	goto_if_set FLAG_GOT_MASTER_BALL_FROM_SILPH, SilphCo_11F_EventScript_AlreadyGotMasterBall
	checkplayergender
	call_if_eq VAR_RESULT, MALE, SilphCo_11F_EventScript_PresidentThanksMale
	call_if_eq VAR_RESULT, FEMALE, SilphCo_11F_EventScript_PresidentThanksFemale
	checkitemspace ITEM_MASTER_BALL
	goto_if_eq VAR_RESULT, FALSE, SilphCo_11F_EventScript_NoRoomForMasterBall
	giveitem_msg SilphCo_11F_Text_ObtainedMasterBallFromPresident, ITEM_MASTER_BALL, 1, MUS_OBTAIN_KEY_ITEM
	msgbox SilphCo_11F_Text_ThatsOurSecretPrototype
	call SilphCo_11F_EventScript_RecordMewtwoSilphRumor
	setflag FLAG_GOT_MASTER_BALL_FROM_SILPH
	release
	end

SilphCo_11F_EventScript_PresidentThanksMale::
	msgbox SilphCo_11F_Text_ThanksForSavingMeDearBoy
	return

SilphCo_11F_EventScript_PresidentThanksFemale::
	msgbox SilphCo_11F_Text_ThanksForSavingMeDearGirl
	return

SilphCo_11F_EventScript_NoRoomForMasterBall::
	msgbox SilphCo_11F_Text_YouHaveNoRoomForThis
	release
	end

SilphCo_11F_EventScript_AlreadyGotMasterBall::
	msgbox SilphCo_11F_Text_ThatsOurSecretPrototype
	call SilphCo_11F_EventScript_RecordMewtwoSilphRumor
	release
	end

SilphCo_11F_EventScript_RecordMewtwoSilphRumor::
	setvar VAR_0x8004, SUB_QUEST_APEX_MEWTWO
	setvar VAR_0x8005, 1
	call EventScript_RecordApexRumorWithFeedback
	return

SilphCo_11F_EventScript_Secretary::
	msgbox SilphCo_11F_Text_ThanksForRescuingUs, MSGBOX_NPC
	end

SilphCo_11F_EventScript_GiovanniTriggerLeft::
	lockall
	setvar VAR_TEMP_1, 0
	goto SilphCo_11F_EventScript_BattleGiovanni
	end

SilphCo_11F_EventScript_GiovanniTriggerMiddle::
	lockall
	setvar VAR_TEMP_1, 1
	goto SilphCo_11F_EventScript_BattleGiovanni
	end

SilphCo_11F_EventScript_GiovanniTriggerRight::
	lockall
	setvar VAR_TEMP_1, 2
	goto SilphCo_11F_EventScript_BattleGiovanni
	end

SilphCo_11F_EventScript_BattleGiovanni::
	textcolor NPC_TEXT_COLOR_NEUTRAL
	msgbox SilphCo_11F_Text_PresidentInterruptsGiovanni
	msgbox SilphCo_11F_Text_GiovanniScoffs
	closemessage
	playse SE_PIN
	applymovement LOCALID_SILPH_CO_GIOVANNI, Common_Movement_ExclamationMark
	applymovement LOCALID_SILPH_CO_PRESIDENT, Common_Movement_ExclamationMark
	applymovement LOCALID_SILPH_CO_SECRETARY, Common_Movement_ExclamationMark
	waitmovement 0
	waitfieldeffect FLDEFF_EXCLAMATION_MARK_ICON
	delay 12
	applymovement LOCALID_SILPH_CO_GIOVANNI, Common_Movement_WalkInPlaceFasterDown
	waitmovement 0
	delay 8
	msgbox SilphCo_11F_Text_GiovanniIntro
	closemessage
	call_if_eq VAR_TEMP_1, 0, SilphCo_11F_EventScript_PlayerApproachGiovanniLeft
	call_if_eq VAR_TEMP_1, 1, SilphCo_11F_EventScript_PlayerApproachGiovanniMiddle
	call_if_eq VAR_TEMP_1, 2, SilphCo_11F_EventScript_PlayerApproachGiovanniRight
	msgbox SilphCo_11F_Text_GiovanniChallenge
	closemessage
	setvar VAR_LAST_TALKED, LOCALID_SILPH_CO_GIOVANNI
	trainerbattle_no_intro TRAINER_BOSS_GIOVANNI_2, SilphCo_11F_Text_GiovanniDefeat
	apexlog APEX_LOG_PERSON_GIOVANNI, 3
	msgbox SilphCo_11F_Text_GiovanniPostBattle
	closemessage
	setflag FLAG_GIOVANNI_ACTIVATED_MEWTWO_SIGNAL
	logbookmenu LOGBOOK_MENU_SET_ACTIVE, QUEST_GIOVANNIS_AMBITION
	sublogbookmenu LOGBOOK_MENU_UNLOCK_QUEST, QUEST_GIOVANNIS_AMBITION, SUB_QUEST_GIOVANNI_SILPH_SIGNAL
	sublogbookmenu LOGBOOK_MENU_COMPLETE_QUEST, QUEST_GIOVANNIS_AMBITION, SUB_QUEST_GIOVANNI_SILPH_SIGNAL
	sublogbookmenu LOGBOOK_MENU_UNLOCK_QUEST, QUEST_GIOVANNIS_AMBITION, SUB_QUEST_GIOVANNI_ROUTE7_RAMPAGE
	fadescreen FADE_TO_BLACK
	removeobject LOCALID_SILPH_CO_GIOVANNI
	removeobject LOCALID_SILPH_CO_11F_GRUNT1
	removeobject LOCALID_SILPH_CO_11F_GRUNT2
	fadescreen FADE_FROM_BLACK
	setvar VAR_MAP_SCENE_SILPH_CO_11F, 1
	setflag FLAG_HIDE_SAFFRON_ROCKETS
	setflag FLAG_HIDE_SILPH_ROCKETS
	clearflag FLAG_HIDE_SAFFRON_CIVILIANS
	releaseall
	end

SilphCo_11F_EventScript_PlayerApproachGiovanniLeft::
	applymovement LOCALID_PLAYER, SilphCo_11F_Movement_PlayerApproachGiovanniLeft
	waitmovement 0
	return

SilphCo_11F_EventScript_PlayerApproachGiovanniMiddle::
	applymovement LOCALID_PLAYER, SilphCo_11F_Movement_PlayerApproachGiovanniMiddle
	waitmovement 0
	return

SilphCo_11F_EventScript_PlayerApproachGiovanniRight::
	applymovement LOCALID_PLAYER, SilphCo_11F_Movement_PlayerApproachGiovanniRight
	waitmovement 0
	return

SilphCo_11F_Movement_PlayerApproachGiovanniLeft::
	walk_up
	walk_up
	walk_right
	walk_right
	walk_right
	walk_in_place_faster_right
	step_end

SilphCo_11F_Movement_PlayerApproachGiovanniMiddle::
	walk_up
	walk_up
	walk_right
	walk_right
	walk_in_place_faster_right
	step_end

SilphCo_11F_Movement_PlayerApproachGiovanniRight::
	walk_up
	walk_up
	walk_left
	walk_left
	walk_in_place_faster_left
	step_end

@ Unused
SilphCo_11F_EventScript_Monitor::
	msgbox SilphCo_11F_Text_MonitorHasMonsOnIt, MSGBOX_SIGN
	end

SilphCo_11F_EventScript_FloorSign::
	msgbox SilphCo_11F_Text_FloorSign, MSGBOX_SIGN
	end

