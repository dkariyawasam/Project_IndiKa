	releaseall
	end

FuchsiaCity_Gym_Movement_GymGuideJumpOut::
	set_visible
	jump_in_place_down
	walk_down
	step_end

FuchsiaCity_Gym_Movement_PlayerStepAsideForGuide::
	walk_right
	walk_in_place_faster_left
	step_end

FuchsiaCity_Gym_Movement_GymGuideLeave::
	walk_down
	walk_down
	step_end
