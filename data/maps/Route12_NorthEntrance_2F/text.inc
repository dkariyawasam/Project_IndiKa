Route12_NorthEntrance_2F_Text_RememberPokemon::
    .string "My POKéMON's ashes are stored in\n"
    .string "POKéMON TOWER.\p"
    .string "I come here when I need a quiet\n"
    .string "place to remember them.\p"
    .string "If you treat your POKéMON well,\n"
    .string "they'll return your love by working\l"
    .string "their hardest in battle.$"

Route12_NorthEntrance_2F_Text_TheresManFishing::
    .string "Let's see what the binoculars have\n"
    .string "to show…\p"
    .string "There's a man fishing!$"

Route12_NorthEntrance_2F_Text_ItsPokemonTower::
    .string "Let's see what the binoculars have\n"
    .string "to show…\p"
    .string "It's POKéMON TOWER!$"

Route12_NorthEntrance_2F_Text_ExplainSootheBell::
    .string "Let a POKéMON hold this bell.\n"
    .string "It helps your friendship grow.$"

Route12_NorthEntrance_2F_Text_ResearchGrant::
    .string "A fellow FIELD AIDE! PROF. OAK\n"
    .string "has set aside research support.\p"
    .string "At 50 species owned, you qualify\n"
    .string "for a ¥5,000 fieldwork stipend\p"
    .string "and a SOOTHE BELL.\n"
    .string "May I review your POKéDEX?$"

Route12_NorthEntrance_2F_Text_StipendReceived::
    .string "{PLAYER} received ¥5,000\n"
    .string "as a fieldwork stipend!\p"
    .string "Thank you for your continued\n"
    .string "support of our POKéMON research.$"

Route12_NorthEntrance_2F_Text_ResearchRepeat::
    .string "Your research award is recorded.\n"
    .string "Thank you for your fieldwork!$"

Route12_NorthEntrance_2F_Text_WalletFull::
    .string "You can't carry the full stipend.\n"
    .string "I'll keep it here for you.$"
