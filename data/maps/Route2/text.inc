Route2_Text_RouteSign::
    .string "ROUTE 2\n"
    .string "VIRIDIAN CITY - PEWTER CITY$"

Route2_Text_DiglettsCave::
    .string "DIGLETT'S CAVE$"

Route2_Text_RivalFieldworkAllLeads::
	.string "{RIVAL}: Ha! Hey, {PLAYER}.\n"
	.string "Bet you're heading to PEWTER!\p"
	.string "Still thinking like a tourist,\n"
	.string "huh?\p"
	.string "Everyone acts like KANTO is\n"
	.string "one straight road.\p"
	.string "There are better leads through\n"
	.string "DIGLETT'S CAVE, VIRIDIAN\l"
	.string "CHANNEL, and the ferry south\l"
	.string "of PALLET.\p"
	.string "So, go on.\n"
	.string "Pick the obvious road if you want.\p"
	.string "I'll be doing actual fieldwork.$"

