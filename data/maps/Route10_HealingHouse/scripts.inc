	.equ REQUIRED_OWNED_MONS, 20

Route10_HealingHouse_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, Route10_HealingHouse_OnTransition
	.byte 0

Route10_HealingHouse_OnTransition::
	setrespawn HEAL_LOCATION_ROUTE10
	end

Route10_HealingHouse_EventScript_Healer::
	lock
	faceplayer
	msgbox Route10_HealingHouse_Text_RestHere, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, Route10_HealingHouse_EventScript_Goodbye
	message Route10_HealingHouse_Text_TakeShortRest
	waitmessage
	call EventScript_PkmnCenterNurse_TakeAndHealPkmn
	msgbox Route10_HealingHouse_Text_Rested
	release
	end

Route10_HealingHouse_EventScript_Goodbye::
	msgbox Route10_HealingHouse_Text_Goodbye
	release
	end

Route10_HealingHouse_EventScript_FatMan::
	msgbox Route10_HealingHouse_Text_NuggetUselessSoldFor5000, MSGBOX_NPC
	end

Route10_HealingHouse_EventScript_Gentleman::
	msgbox Route10_HealingHouse_Text_EveryTypeStrongerThanOthers, MSGBOX_NPC
	end

Route10_HealingHouse_EventScript_Youngster::
	msgbox Route10_HealingHouse_Text_HeardGhostsHauntLavender, MSGBOX_NPC
	end

Route10_HealingHouse_EventScript_Aide::
	lock
	faceplayer
	call Route10_HealingHouse_EventScript_GetAideRequestInfo
	goto_if_set FLAG_GOT_EVERSTONE_FROM_OAKS_AIDE, Route10_HealingHouse_EventScript_AlreadyGotEverstone
	msgbox Route10_HealingHouse_Text_GiveEverstoneIfCaught20Mons, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, Aide_EventScript_DeclineCheckMons
	setvar VAR_0x8004, 0
	specialvar VAR_RESULT, GetPokedexCount
	buffernumberstring STR_VAR_3, VAR_0x8006
	call Route10_HealingHouse_EventScript_GetAideRequestInfo
	goto_if_lt VAR_0x8006, REQUIRED_OWNED_MONS, Aide_EventScript_HaventCaughtEnough
	msgbox Route10_HealingHouse_Text_GreatHereYouGo
	checkitemspace ITEM_EVERSTONE
	goto_if_eq VAR_RESULT, FALSE, Aide_EventScript_NoRoomForItem
	giveitem_msg Route10_HealingHouse_Text_ReceivedEverstoneFromAide, ITEM_EVERSTONE
	setflag FLAG_GOT_EVERSTONE_FROM_OAKS_AIDE
	msgbox Route10_HealingHouse_Text_ExplainEverstone
	release
	end

Route10_HealingHouse_EventScript_AlreadyGotEverstone::
	msgbox Route10_HealingHouse_Text_ExplainEverstone
	release
	end

Route10_HealingHouse_EventScript_GetAideRequestInfo::
	buffernumberstring STR_VAR_1, REQUIRED_OWNED_MONS
	bufferitemname STR_VAR_2, ITEM_EVERSTONE
	return
